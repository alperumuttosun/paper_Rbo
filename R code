      cp_x <- prefilter(cp_x, M_REP, median(cp_x$sigma^2))
      cat(sprintf("11c: %s %s (%d tekrar x %d permütasyon)...\n", s11$base, s11$name, R_GLOB, B_GLOB_SIM))
      res <- run_reps(R_GLOB, function(r) {
        labs_s <- lapply(seq_len(s11$L), function(l) sim_lab(cp_x, s11$n, s11$kap * cp_x$sigma))
        obs <- glob_stat_n(labs_s, SPL10, BTW10)
        perm <- replicate(B_GLOB_SIM, glob_stat_n(permute_labs(labs_s), SPL10, BTW10))
        c(T = obs, p = (1 + sum(perm <= obs)) / (B_GLOB_SIM + 1))
      }, n_serial = R_GLOB_SER)
      v <- do.call(rbind, res)
      gx <- rbind(gx, data.frame(base = s11$base, scenario = s11$name, n_labs = s11$L, n_rep_per_sample = s11$n,
        kappa = s11$kap, n_sim = nrow(v), B_perm = B_GLOB_SIM, mean_T = mean(v[, "T"]),
        reject_05 = mean(v[, "p"] <= 0.05), reject_10 = mean(v[, "p"] <= 0.10)))
      write.csv(gx, f11d, row.names = FALSE)
    }
    print(gx, digits = 3)
  }
  cat(sprintf("step11 bitti. Süre: %.1f dakika\n", as.numeric(difftime(Sys.time(), t11, units = "mins"))))
