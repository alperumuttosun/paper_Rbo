               Laboratories = length(Cl), Replicates_per_lab = paste(unique(reps), collapse = "-"),
               Genes_after_filter = cal$n_genes[cfg_label(cal$dataset, cal$contrast) == nm][1],
               Floor = signif(floors[nm], 2),
               Ceiling_C_range = sprintf("%.2f-%.2f", min(Cl), max(Cl)),
               Simulated_C_kappa0 = round(cv$mean_C[cv$label == nm & cv$kappa == 0], 2))
  }))
  write.csv(t1, f_t1, row.names = FALSE)

  # Tablo 2: genel testler + dışarıda bırakma
  gl <- read.csv(f_glob); lo <- read.csv(f_loo)
  t2 <- rbind(data.frame(Configuration = cfg_label(gl$dataset, gl$contrast), Laboratories_excluded = "none",
                         Laboratories = gl$n_labs, Mean_rho_observed = round(gl$T_obs, 3),
                         Mean_rho_permutation = round(gl$T_perm_mean, 3), p_value = gl$p_global, Permutations = gl$B),
              data.frame(Configuration = cfg_label(lo$dataset, lo$contrast), Laboratories_excluded = lo$left_out,
                         Laboratories = lo$n_labs, Mean_rho_observed = round(lo$T_obs, 3),
                         Mean_rho_permutation = round(lo$T_perm_mean, 3), p_value = lo$p_global, Permutations = lo$B))
  t2 <- t2[order(t2$Configuration, t2$Laboratories_excluded != "none"), ]
  write.csv(t2, f_t2, row.names = FALSE)
  print(t1); print(t2)
}

