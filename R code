      T_perm_mean = mean(perm[1, ]), T_perm_q05 = quantile(perm[1, ], 0.05, names = FALSE),
      p_global = pg, B = B_GLOBAL)
    pl <- sapply(seq_along(labs), function(l) (1 + sum(perm[1 + l, ] <= obs$lab[l])) / (B_GLOBAL + 1))
    lt[[length(lt) + 1]] <- data.frame(cf, lab = names(labs), C = obs$C,
      mean_rho_with_others = sapply(seq_along(labs), function(l) mean(obs$R[l, -l])),
      stat = obs$lab, perm_mean = rowMeans(perm[-1, , drop = FALSE]),
      p_lab = pl, p_lab_bh = p.adjust(pl, method = "BH"), row.names = NULL)
