# ---- step02: validation of the null distribution ----
f_mom <- "step02_null_moments.csv"
f_q   <- "step02_null_quantiles.csv"
f_t1  <- "step02_type1.csv"

if (!REDO_STEP02 && all(file.exists(c(f_mom, f_q, f_t1)))) {
  cat("step02 outputs exist, skipping (set REDO_STEP02 <- TRUE to rerun).\n")
} else {

  t_start <- Sys.time()
  design  <- expand.grid(N = c(200, 2000, 20000),
                         k = c(10, 50, 100))
  p_set   <- c(0.90, 0.98)
  types   <- c("prefix", "ext")
  alphas  <- c(0.10, 0.05, 0.01)

  out_mom <- list(); out_q <- list(); out_t1 <- list()

  for (r in seq_len(nrow(design))) {
    N <- design$N[r]; k <- design$k[r]
    cat(sprintf("N = %d, k = %d ...\n", N, k))

    Xmc <- null_paths_mc(N, k, B_MC)

    impl_diff <- max(replicate(200, {
      S <- sample.int(N, k); Tl <- sample.int(N, k)
      max(abs(overlap_path_A(S, Tl, k) - overlap_path_B(S, Tl, k)))
    }))

    for (p in p_set) for (ty in types) {
      w    <- rbo_weights(k, p, ty)
      t_mc <- as.vector(Xmc %*% w)
      mom  <- null_moments_exact(N, k, w)

      hyp  <- dhyper(0:k, k, N - k, k)
      hyp_diff <- max(abs(mom$pX_k - hyp))

      dist <- tryCatch(null_dist_dp(N, k, w, mom),
                       error = function(e) NULL)
      dp_ok <- !is.null(dist)

      out_mom[[length(out_mom) + 1]] <- data.frame(
        N = N, k = k, p = p, type = ty,
        mean_exact = mom$mean, mean_mc = mean(t_mc),
        sd_exact = mom$sd, sd_mc = sd(t_mc),
        z_mean_diff = (mean(t_mc) - mom$mean) / (mom$sd / sqrt(B_MC)),
        maxdiff_chain_vs_hyper = hyp_diff,
        maxdiff_impl_A_vs_B = impl_diff)

      t_hat <- if (dp_ok) score_grid(Xmc, dist) else t_mc
      q_mc <- quantile(t_hat, c(0.95, 0.99), names = FALSE, type = 1)
      q_dp <- if (dp_ok) quantile_dp(c(0.95, 0.99), dist) else c(NA, NA)
      out_q[[length(out_q) + 1]] <- data.frame(
        N = N, k = k, p = p, type = ty,
        q95_exact = q_dp[1], q95_mc = q_mc[1],
        q99_exact = q_dp[2], q99_mc = q_mc[2],
        ks_exact_vs_mc = if (dp_ok) ks_dp_mc(dist, t_hat) else NA,
        ks_5pct_critical = 1.36 / sqrt(B_MC),
        max_rounding_error = max(abs(t_hat - t_mc)),
        tail_mass_beyond_cap = if (dp_ok) dist$tail_mass else NA,
        dp_ok = dp_ok)

      if (dp_ok) {
        pv <- pvalue_dp(t_hat, dist)
        for (al in alphas) {
          rr <- mean(pv <= al)
          out_t1[[length(out_t1) + 1]] <- data.frame(
            N = N, k = k, p = p, type = ty, alpha = al,
            reject_rate = rr,
            mc_se = sqrt(al * (1 - al) / B_MC))
        }
      }
    }
  }

  write.csv(do.call(rbind, out_mom), f_mom, row.names = FALSE)
  write.csv(do.call(rbind, out_q),   f_q,   row.names = FALSE)
  write.csv(do.call(rbind, out_t1),  f_t1,  row.names = FALSE)
  cat(sprintf("step02 done. Time: %.1f min\n",
              as.numeric(difftime(Sys.time(), t_start, units = "mins"))))
}

