    cat(sprintf("11a: idr paketi %s, marr paketi %s\n", ifelse(has_idr, "var", "YOK"), ifelse(has_marr, "var", "YOK")))
    run_idr <- function(a, b) {                             # IDR < 0.05 olan gen sayısı (|LFC| büyük = güçlü sinyal)
      if (!has_idr) return(c(NA, "idr paketi yok"))
      tryCatch({ fit <- idr::est.IDR(cbind(abs(a), abs(b)), mu = 2.6, sigma = 1.3, rho = 0.8, p = 0.1,
                                     eps = 0.001, max.ite = 30)
                 c(sum(fit$IDR < 0.05), "ok") }, error = function(e) c(NA, conditionMessage(e)))
    }
    run_marr <- function(a, b) {                            # MaRR: yeniden üretilebilir gen yüzdesi (tek örnek çifti)
      if (!has_marr) return(c(NA, "marr paketi yok"))
      tryCatch({ m <- marr::Marr(cbind(abs(a), abs(b)), pSamplepairs = 0.75, pFeatures = 0.75, alpha = 0.05)
                 v <- marr::MarrSamplepairs(m); c(as.numeric(v[1]), "ok") }, error = function(e) c(NA, conditionMessage(e)))
    }
