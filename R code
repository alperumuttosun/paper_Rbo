  write.csv(do.call(rbind, gl), f_glob, row.names = FALSE)
  write.csv(do.call(rbind, lt), f_labt, row.names = FALSE)
  print(do.call(rbind, gl), digits = 3); print(do.call(rbind, lt), digits = 3); print(do.call(rbind, s2), digits = 3)
  cat(sprintf("step07 done. Time: %.1f min\n", as.numeric(difftime(Sys.time(), t7, units = "mins"))))
}

# ---- step08: batch diagnostic and leave-out tests ----
REDO_STEP08 <- FALSE  # TRUE recomputes the step
BATCH_MIN   <- 0.5  # batch score threshold (fixed in advance)
B_LOO       <- 199  # permutations in leave-out tests
SPL8        <- 30  # splits per laboratory
BTW8        <- 30  # lists per laboratory

f_bdiag <- "step08_batch_diag.csv"
f_bpair <- "step08_batch_aware_pairs.csv"
f_loo   <- "step08_leave_out_tests.csv"

best_partition <- function(M) {
  n <- ncol(M); best <- -Inf; bg <- NULL
  for (g1 in combn(n, floor(n / 2), simplify = FALSE)) {
    g <- rep(2, n); g[g1] <- 1
    w <- outer(g, g, "=="); diag(w) <- NA
    sc <- mean(M[which(w)]) - mean(M[which(!w)])
    if (sc > best) { best <- sc; bg <- g }
  }
  list(score = best, g = bg)
}
same_part <- function(a, b) length(a) == length(b) && (all(a == b) || all(a == 3 - b))

lab_lists_batch <- function(lab, ranking, s0) {
  iA <- split(seq_len(ncol(lab$A)), lab$bA); iB <- split(seq_len(ncol(lab$B)), lab$bB)
  pick1 <- function(v) v[sample.int(length(v), 1)]
  half2 <- function(idx) { s <- lapply(idx, function(v) v[sample.int(length(v), 2)])
                           list(sapply(s, `[`, 1), sapply(s, `[`, 2)) }
  C <- mean(replicate(SPL8, { ha <- half2(iA); hb <- half2(iB)
    rbo_lists(list_sim(lab, ha[[1]], hb[[1]], ranking, s0), list_sim(lab, ha[[2]], hb[[2]], ranking, s0)) }))
  pool <- replicate(BTW8, list_sim(lab, sapply(iA, pick1), sapply(iB, pick1), ranking, s0), simplify = FALSE)
  list(C = C, pool = pool)
}

global_p <- function(labs, ranking, s0, B) {
  obs <- all_stats(labs, ranking, s0)$glob
  perm <- replicate(B, all_stats(permute_labs(labs), ranking, s0)$glob)
  c(T_obs = obs, T_perm_mean = mean(perm), p = (1 + sum(perm <= obs)) / (B + 1))
}

if (!REDO_STEP08 && all(file.exists(c(f_bdiag, f_bpair, f_loo)))) {
  cat("step08 outputs exist, skipping (set REDO_STEP08 <- TRUE to rerun).\n")
} else {
  t8 <- Sys.time(); set.seed(20261031)
  par8 <- readRDS(f_par)
  ds8 <- list()
  if (file.exists(f_maqc)) ds8$MAQC <- prep_maqc(readRDS(f_maqc))
  if (file.exists(f_seqc)) ds8$SEQC <- prep_seqc(readRDS(f_seqc))
  ctr <- list("A-B" = c("A", "B"), "C-D" = c("C", "D"))

  bd <- list(); flags <- list()
  for (dn in names(ds8)) for (ln in names(ds8[[dn]])) {
    pa <- best_partition(rep_cor(ds8[[dn]][[ln]]$A)); pb <- best_partition(rep_cor(ds8[[dn]][[ln]]$B))
    fl <- pa$score >= BATCH_MIN && pb$score >= BATCH_MIN && same_part(pa$g, pb$g)
    bd[[length(bd) + 1]] <- data.frame(dataset = dn, lab = ln, score_A = pa$score, part_A = paste(pa$g, collapse = ""),
                                       score_B = pb$score, part_B = paste(pb$g, collapse = ""),
                                       same_partition = same_part(pa$g, pb$g), batch_flag = fl)
    if (fl) flags[[paste(dn, ln)]] <- list(bA = pa$g, bB = pb$g)
  }
  write.csv(do.call(rbind, bd), f_bdiag, row.names = FALSE)

  bp <- list()
  for (key in names(flags)) {
    dn <- sub(" .*", "", key); ln <- sub("^[^ ]+ ", "", key); labs0 <- ds8[[dn]]
    s0 <- median(par8[[paste(dn, "A-B")]]$sigma^2); keep <- prefilter_real(labs0, "A", "B", s0)
    labs <- lapply(labs0, sub_lab, g1 = "A", g2 = "B", keep = keep)
    lf <- labs[[ln]]; lf$bA <- flags[[key]]$bA; lf$bB <- flags[[key]]$bB
    Ls <- lab_lists(lf, "LFC", s0); Lb <- lab_lists_batch(lf, "LFC", s0)
    for (o in setdiff(names(labs), ln)) {
      Lo <- lab_lists(labs[[o]], "LFC", s0)
      Es <- mean(mapply(rbo_lists, Ls$pool, Lo$pool)); Eb <- mean(mapply(rbo_lists, Lb$pool, Lo$pool))
      bp[[length(bp) + 1]] <- data.frame(dataset = dn, batch_lab = ln, other_lab = o, C_other = Lo$C,
        C_standard = Ls$C, E_standard = Es, rho_standard = Es / sqrt(Ls$C * Lo$C),
        C_batch_aware = Lb$C, E_batch_aware = Eb, rho_batch_aware = Eb / sqrt(Lb$C * Lo$C))
    }
  }
  write.csv(if (length(bp)) do.call(rbind, bp) else data.frame(note = "no laboratory with batch structure"),
            f_bpair, row.names = FALSE)

  loo_plan <- list(list(dataset = "MAQC", contrast = "A-B", drops = c(as.list(names(ds8$MAQC)), list(c("lab1", "lab6")))),
                   list(dataset = "MAQC", contrast = "C-D", drops = c(as.list(names(ds8$MAQC)), list(c("lab1", "lab6")))),
                   list(dataset = "SEQC", contrast = "A-B", drops = list("MAY")))
  lo <- list()
  for (pl in loo_plan) {
    labs0 <- ds8[[pl$dataset]]; if (is.null(labs0)) next
    g1 <- ctr[[pl$contrast]][1]; g2 <- ctr[[pl$contrast]][2]
    s0 <- median(par8[[paste(pl$dataset, pl$contrast)]]$sigma^2); keep <- prefilter_real(labs0, g1, g2, s0)
    labs <- lapply(labs0, sub_lab, g1 = g1, g2 = g2, keep = keep)
    for (dr in pl$drops) {
      dr <- intersect(dr, names(labs)); if (!length(dr)) next
      cat(sprintf("leave-out: %s %s - %s ...\n", pl$dataset, pl$contrast, paste(dr, collapse = "+")))
      v <- global_p(labs[setdiff(names(labs), dr)], "LFC", s0, B_LOO)
      lo[[length(lo) + 1]] <- data.frame(dataset = pl$dataset, contrast = pl$contrast, ranking = "LFC",
        left_out = paste(dr, collapse = "+"), n_labs = length(labs) - length(dr),
        T_obs = v[["T_obs"]], T_perm_mean = v[["T_perm_mean"]], p_global = v[["p"]], B = B_LOO)
    }
  }
  write.csv(do.call(rbind, lo), f_loo, row.names = FALSE)
  print(do.call(rbind, bd), digits = 3); if (length(bp)) print(do.call(rbind, bp), digits = 3); print(do.call(rbind, lo), digits = 3)
  cat(sprintf("step08 done. Time: %.1f min\n", as.numeric(difftime(Sys.time(), t8, units = "mins"))))
}

