# ---------------------------------------------------------------------
# step02: SENTETİK DOĞRULAMA
# ---------------------------------------------------------------------
f_mom <- "step02_null_moments.csv"                          # çıktı 1: kesin vs MC ortalama/sd
f_q   <- "step02_null_quantiles.csv"                        # çıktı 2: kesin vs MC quantile + KS
f_t1  <- "step02_type1.csv"                                 # çıktı 3: tip I hata oranları

if (!REDO_STEP02 && all(file.exists(c(f_mom, f_q, f_t1)))) {  # çıktılar zaten varsa
  cat("step02 çıktıları mevcut, atlanıyor (yeniden için REDO_STEP02 <- TRUE).\n")
} else {

  t_start <- Sys.time()                                     # süre ölçümü başlat
  design  <- expand.grid(N = c(200, 2000, 20000),           # evren büyüklüğü (gen sayısı)
                         k = c(10, 50, 100))                # liste derinliği
  p_set   <- c(0.90, 0.98)                                  # RBO ağırlık parametresi
  types   <- c("prefix", "ext")                             # RBO@k ve RBO_EXT
  alphas  <- c(0.10, 0.05, 0.01)                            # tip I hata düzeyleri

  out_mom <- list(); out_q <- list(); out_t1 <- list()      # sonuçları toplamak için boş listeler

  for (r in seq_len(nrow(design))) {                        # her (N, k) kombinasyonu için
    N <- design$N[r]; k <- design$k[r]                      # değerleri al
    cat(sprintf("N = %d, k = %d ...\n", N, k))              # ilerlemeyi yaz

    Xmc <- null_paths_mc(N, k, B_MC)                        # Yol B: H0 altında B_MC örtüşme yolu

    # Yol A ve Yol B örtüşme fonksiyonları aynı sonucu veriyor mu? (200 rastgele çift)
    impl_diff <- max(replicate(200, {                       # 200 kez dene
      S <- sample.int(N, k); Tl <- sample.int(N, k)         # rastgele iki liste
      max(abs(overlap_path_A(S, Tl, k) - overlap_path_B(S, Tl, k)))  # farkın en büyüğü
    }))

    for (p in p_set) for (ty in types) {                    # her p ve RBO türü için
      w    <- rbo_weights(k, p, ty)                         # ağırlıklar
      t_mc <- as.vector(Xmc %*% w)                          # Monte Carlo RBO değerleri
      mom  <- null_moments_exact(N, k, w)                   # Yol A: kesin ortalama ve sd

      hyp  <- dhyper(0:k, k, N - k, k)                      # X_k için hipergeometrik dağılım (kontrol)
      hyp_diff <- max(abs(mom$pX_k - hyp))                  # zincirle hipergeometrik aynı olmalı

      dist <- tryCatch(null_dist_dp(N, k, w, mom),          # Yol A: kesin dağılım
                       error = function(e) NULL)            # hata olursa NULL dön
      dp_ok <- !is.null(dist)                               # kesin dağılım çalıştı mı?

      out_mom[[length(out_mom) + 1]] <- data.frame(         # momentler tablosuna satır ekle
        N = N, k = k, p = p, type = ty,
        mean_exact = mom$mean, mean_mc = mean(t_mc),        # kesin ve MC ortalama
        sd_exact = mom$sd, sd_mc = sd(t_mc),                # kesin ve MC standart sapma
        z_mean_diff = (mean(t_mc) - mom$mean) / (mom$sd / sqrt(B_MC)),  # fark / standart hata (|z|<3 beklenir)
        maxdiff_chain_vs_hyper = hyp_diff,                  # zincir doğruluğu (~0 beklenir)
        maxdiff_impl_A_vs_B = impl_diff)                    # iki örtüşme fonksiyonu farkı (0 beklenir)

      t_hat <- if (dp_ok) score_grid(Xmc, dist) else t_mc   # MC yollarının ızgara skoru (DP ile aynı yuvarlama)
      q_mc <- quantile(t_hat, c(0.95, 0.99), names = FALSE, type = 1)  # MC quantile'lar
      q_dp <- if (dp_ok) quantile_dp(c(0.95, 0.99), dist) else c(NA, NA)  # kesin quantile'lar
      out_q[[length(out_q) + 1]] <- data.frame(             # quantile tablosuna satır ekle
        N = N, k = k, p = p, type = ty,
        q95_exact = q_dp[1], q95_mc = q_mc[1],              # %95 quantile
        q99_exact = q_dp[2], q99_mc = q_mc[2],              # %99 quantile
        ks_exact_vs_mc = if (dp_ok) ks_dp_mc(dist, t_hat) else NA,  # KS uzaklığı
        ks_5pct_critical = 1.36 / sqrt(B_MC),               # KS bu değerin altındaysa fark yok demektir
        max_rounding_error = max(abs(t_hat - t_mc)),        # ızgara skoru ile gerçek RBO farkı (çok küçük beklenir)
        tail_mass_beyond_cap = if (dp_ok) dist$tail_mass else NA,  # üst sınır ötesi olasılık (~0 beklenir)
        dp_ok = dp_ok)                                      # kesin dağılım hesaplandı mı

      if (dp_ok) {                                          # tip I hata: MC değerlerini kesin p-değeriyle test et
        pv <- pvalue_dp(t_hat, dist)                        # her MC değeri için kesin p-değeri
        for (al in alphas) {                                # her alfa için
          rr <- mean(pv <= al)                              # reddetme oranı (alfa'dan küçük/eşit beklenir)
          out_t1[[length(out_t1) + 1]] <- data.frame(
            N = N, k = k, p = p, type = ty, alpha = al,
            reject_rate = rr,                               # gözlenen tip I hata
            mc_se = sqrt(al * (1 - al) / B_MC))             # MC standart hatası
        }
      }
    }
  }

  write.csv(do.call(rbind, out_mom), f_mom, row.names = FALSE)   # çıktı 1'i kaydet
  write.csv(do.call(rbind, out_q),   f_q,   row.names = FALSE)   # çıktı 2'yi kaydet
  write.csv(do.call(rbind, out_t1),  f_t1,  row.names = FALSE)   # çıktı 3'ü kaydet
  cat(sprintf("step02 bitti. Süre: %.1f dakika\n",
              as.numeric(difftime(Sys.time(), t_start, units = "mins"))))  # toplam süreyi yaz
}


