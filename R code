# --- 1a) Örtüşme yolu X_d: her derinlik d için ilk d öğedeki ortak öğe sayısı ---

# Yol A (hızlı): her ortak öğe, iki listedeki sırasının büyüğü olan derinlikten itibaren sayılır
overlap_path_A <- function(S, Tl, k) {
  S  <- S[1:k]; Tl <- Tl[1:k]                               # iki listenin ilk k öğesini al
  j  <- match(S, Tl)                                        # S'deki her öğenin T'deki sırası (yoksa NA)
  i  <- seq_len(k)                                          # S'deki sıralar 1..k
  ok <- !is.na(j)                                           # iki listede de olan öğeler
  m  <- pmax(i[ok], j[ok])                                  # öğenin "görüldüğü" derinlik = iki sıranın büyüğü
  cumsum(tabulate(m, nbins = k))                            # derinlik derinlik birikimli ortak sayısı
}

# Yol B (yavaş ama çok basit): her derinlikte kesişimi doğrudan say
overlap_path_B <- function(S, Tl, k) {
  sapply(seq_len(k), function(d) length(intersect(S[1:d], Tl[1:d])))  # her d için |S_1:d ∩ T_1:d|
}

# --- 1b) RBO ağırlıkları: RBO = sum_d w_d * X_d  (hem önek hem ekstrapole RBO doğrusal) ---
rbo_weights <- function(k, p, type = c("prefix", "ext")) {
  type <- match.arg(type)                                   # "prefix" = RBO@k, "ext" = RBO_EXT
  d <- seq_len(k)                                           # derinlikler 1..k
  w <- (1 - p) * p^(d - 1) / d                              # Webber vd. (2010) ağırlıkları: (1-p) p^(d-1) / d
  if (type == "ext") w[k] <- w[k] + p^k / k                 # RBO_EXT: son derinliğe X_k p^k / k terimi eklenir
  w                                                         # ağırlık vektörünü döndür
}

# --- 1c) İki listenin RBO değeri ---
rbo_value <- function(S, Tl, k, p, type = "ext", method = "A") {
  X <- if (method == "A") overlap_path_A(S, Tl, k) else overlap_path_B(S, Tl, k)  # örtüşme yolu
  sum(rbo_weights(k, p, type) * X)                          # ağırlıklı toplam = RBO
}

# --- 1d) H0 altında tek adım geçiş olasılıkları (Teorem 1) ---
# H0: iki liste, N öğelik evrenin birbirinden bağımsız, tamamen rastgele sıralamaları.
# X_{d-1} = x iken bir sonraki derinlikte artış 0, 1 veya 2 olabilir.
step_probs <- function(x, dprev, N) {
  r  <- N - dprev                                           # her listede henüz görülmemiş öğe sayısı
  a  <- (dprev - x) / r                                     # yeni öğenin diğer listenin önekinde olma olasılığı
  p2 <- a^2                                                 # iki yeni öğe de karşı listede zaten var: +2
  p1 <- 2 * a * (1 - a) + (1 - a) / r                       # tek taraf eşleşir ya da iki yeni öğe aynı: +1
  p0 <- (1 - a) * (1 - a - 1 / r)                           # hiçbir eşleşme yok: +0
  c(p0, p1, p2)                                             # (artış 0, 1, 2) olasılıkları
}

# --- 1e) Yol A: H0 altında KESİN ortalama ve varyans (yuvarlama yok) ---
null_moments_exact <- function(N, k, w) {
  m0 <- c(1, rep(0, k)); m1 <- rep(0, k + 1); m2 <- rep(0, k + 1)  # x=0..k için P, E[T;x], E[T^2;x]
  for (d in seq_len(k)) {                                   # her derinlik için
    n0 <- n1 <- n2 <- rep(0, k + 1)                         # yeni derinliğin boş tabloları
    for (x in 0:(d - 1)) {                                  # önceki derinlikte mümkün x değerleri
      if (m0[x + 1] == 0) next                              # olasılığı sıfır olan durumu atla
      pr <- step_probs(x, d - 1, N)                         # geçiş olasılıkları
      for (inc in 0:2) {                                    # artış 0, 1, 2
        xn <- x + inc                                       # yeni örtüşme
        if (xn > d) next                                    # d'den büyük olamaz
        a  <- w[d] * xn                                     # bu adımda skora eklenen miktar
        q  <- pr[inc + 1]                                   # geçiş olasılığı
        n0[xn + 1] <- n0[xn + 1] + q * m0[x + 1]            # olasılık güncelle
        n1[xn + 1] <- n1[xn + 1] + q * (m1[x + 1] + a * m0[x + 1])                          # 1. moment
        n2[xn + 1] <- n2[xn + 1] + q * (m2[x + 1] + 2 * a * m1[x + 1] + a^2 * m0[x + 1])    # 2. moment
      }
    }
    m0 <- n0; m1 <- n1; m2 <- n2                            # bir sonraki derinliğe geç
  }
  mu <- sum(m1); v <- sum(m2) - mu^2                        # kesin ortalama ve varyans
  list(mean = mu, sd = sqrt(max(v, 0)), pX_k = m0)          # pX_k = X_k'nın kesin dağılımı
}

# --- 1f) Yol A: H0 altında KESİN dağılım (dinamik programlama) ---
# Fikir: RBO = sum_d w_d X_d = sum_j Delta_j * W_j,  W_j = w_j + ... + w_k (kuyruk ağırlığı),
# Delta_j = X_j - X_{j-1} ∈ {0,1,2}. Her artış skoru Delta_j * W_j kadar büyütür.
# Bu artışlar ızgaraya yuvarlanır: T_hat = h * sum_j round(Delta_j * W_j / h).
# DP, T_hat'in dağılımını TAM olarak verir; |T_hat - T| <= X_k * h / 2 (çok küçük).
# Gözlenen listeler için de aynı T_hat kullanılırsa test kesin geçerlidir.
null_dist_dp <- function(N, k, w, mom, n_bins = N_BINS) {
  W     <- rev(cumsum(rev(w)))                              # kuyruk ağırlıkları W_j
  t_max <- sum(w * seq_len(k))                              # teorik en büyük skor (listeler aynıysa)
  m_up  <- qhyper(1e-12, k, N - k, k, lower.tail = FALSE)   # P(X_k > m_up) < 1e-12 (X_k hipergeometrik)
  t_cap <- min(t_max, max(m_up, 1) * W[1])                  # T <= X_k * W_1 olduğundan güvenli üst sınır
  h     <- t_cap / (n_bins - 1)                             # ızgara hücre genişliği
  s1    <- round(W / h); s2 <- round(2 * W / h)             # artış 1 ve 2 için kaç hücre kayılacağı
  P     <- matrix(0, k + 1, n_bins)                         # satır = x (0..k), sütun = skor hücresi
  P[1, 1] <- 1                                              # başlangıç: x = 0, skor = 0
  shift_cols <- function(M, s) {                            # matrisin sütunlarını s hücre sağa kaydır
    if (s == 0) return(M)                                   # kayma yoksa aynen döndür
    out <- matrix(0, nrow(M), n_bins)                       # boş matris
    if (s < n_bins) out[, (1 + s):n_bins] <- M[, 1:(n_bins - s), drop = FALSE]  # kaydırılmış kısım
    keep <- max(1, n_bins - s + 1)                          # taşan sütunların başlangıcı
    out[, n_bins] <- out[, n_bins] + rowSums(M[, keep:n_bins, drop = FALSE])    # taşan kütleyi son hücreye ekle
    out
  }
  for (d in seq_len(k)) {                                   # her derinlik için
    x   <- 0:(d - 1)                                        # önceki derinlikte mümkün x değerleri
    r   <- N - (d - 1)                                      # görülmemiş öğe sayısı
    a   <- (d - 1 - x) / r                                  # Teorem 1'deki a (vektör)
    p0  <- (1 - a) * (1 - a - 1 / r)                        # artış 0 olasılıkları
    p1  <- 2 * a * (1 - a) + (1 - a) / r                    # artış 1 olasılıkları
    p2  <- a^2                                              # artış 2 olasılıkları
    Pr  <- P[x + 1, , drop = FALSE]                         # ilgili satırlar (x = 0..d-1)
    Q   <- matrix(0, k + 1, n_bins)                         # yeni olasılık tablosu
    Q[x + 1, ] <- Q[x + 1, , drop = FALSE] + p0 * Pr                         # artış 0: skor değişmez
    Q[x + 2, ] <- Q[x + 2, , drop = FALSE] + p1 * shift_cols(Pr, s1[d])      # artış 1: W_d kadar kay
    ok2 <- which(x + 2 <= d)                                # artış 2 mümkün olan satırlar
    if (length(ok2) > 0)                                    # varsa
      Q[x[ok2] + 3, ] <- Q[x[ok2] + 3, , drop = FALSE] +
        p2[ok2] * shift_cols(Pr[ok2, , drop = FALSE], s2[d])                 # artış 2: 2*W_d kadar kay
    P <- Q                                                  # bir sonraki derinliğe geç
  }
  list(value = (0:(n_bins - 1)) * h, prob = colSums(P),     # skor değerleri ve olasılıkları
       h = h, s1 = s1, s2 = s2, n_bins = n_bins,            # ızgara bilgileri (gözlenen skor için gerekli)
       tail_mass = sum(P[, n_bins]))                        # üst sınırın ötesindeki kütle
}

# --- 1g) Gözlenen örtüşme yolundan ızgara skoru T_hat (DP ile aynı yuvarlama) ---
score_grid <- function(X, dist) {
  X     <- matrix(X, ncol = length(dist$s1))                # tek yol da olsa matris yap
  Delta <- X - cbind(0, X[, -ncol(X), drop = FALSE])        # her derinlikteki artış (0, 1, 2)
  cells <- (Delta == 1) %*% dist$s1 + (Delta == 2) %*% dist$s2  # toplam hücre kayması
  as.vector(pmin(cells, dist$n_bins - 1)) * dist$h          # üst sınırla kes ve skora çevir
}

# --- 1h) Kesin p-değeri: P(T_hat >= T_hat_gözlenen) ---
pvalue_dp <- function(t_hat, dist) {
  cs <- rev(cumsum(rev(dist$prob)))                         # sağ kuyruk olasılıkları
  cs[pmin(round(t_hat / dist$h) + 1, dist$n_bins)]          # gözlenen hücreden itibaren toplam olasılık
}

# --- 1i) Kesin dağılımdan quantile ---
quantile_dp <- function(prob_level, dist) {
  cdf <- cumsum(dist$prob)                                  # birikimli dağılım
  sapply(prob_level, function(a) dist$value[which(cdf >= a - 1e-12)[1]])  # cdf'nin a'yı ilk geçtiği değer
}

# --- 1j) Yol B: H0 altında Monte Carlo (permütasyon) ile örtüşme yolları ---
null_paths_mc <- function(N, k, B) {
  t(replicate(B, overlap_path_A(sample.int(N, k), sample.int(N, k), k)))  # B satır x k sütun
}

# --- 1k) Kolmogorov-Smirnov uzaklığı: kesin dağılım vs Monte Carlo (aynı T_hat üzerinde) ---
ks_dp_mc <- function(dist, t_hat_mc) {
  cdf  <- cumsum(dist$prob)                                 # kesin cdf (hücre bazında)
  cell <- round(t_hat_mc / dist$h) + 1                      # MC değerlerinin hücre numaraları
  tab  <- tabulate(cell, nbins = dist$n_bins) / length(cell)  # MC olasılıkları (hücre bazında)
  max(abs(cdf - cumsum(tab)))                               # en büyük cdf farkı
}

