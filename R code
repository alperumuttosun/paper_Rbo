cor_matrix <- function(rc, ds, lab, smp) {
  d <- rc[rc$dataset == ds & rc$lab == lab & rc$sample == smp, ]
  reps <- sort(unique(c(d$rep_i, d$rep_j))); n <- length(reps)
  M <- matrix(NA, n, n, dimnames = list(reps, reps))
  for (k in seq_len(nrow(d))) M[as.character(d$rep_i[k]), as.character(d$rep_j[k])] <-
    M[as.character(d$rep_j[k]), as.character(d$rep_i[k])] <- d$r[k]
  M
}
