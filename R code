# ---- step01: functions ----

overlap_path_A <- function(S, Tl, k) {
  S  <- S[1:k]; Tl <- Tl[1:k]
  j  <- match(S, Tl)
  i  <- seq_len(k)
  ok <- !is.na(j)
  m  <- pmax(i[ok], j[ok])
  cumsum(tabulate(m, nbins = k))
}

overlap_path_B <- function(S, Tl, k) {
  sapply(seq_len(k), function(d) length(intersect(S[1:d], Tl[1:d])))
}

rbo_weights <- function(k, p, type = c("prefix", "ext")) {
  type <- match.arg(type)
  d <- seq_len(k)
  w <- (1 - p) * p^(d - 1) / d
  if (type == "ext") w[k] <- w[k] + p^k / k
  w
}

rbo_value <- function(S, Tl, k, p, type = "ext", method = "A") {
  X <- if (method == "A") overlap_path_A(S, Tl, k) else overlap_path_B(S, Tl, k)
  sum(rbo_weights(k, p, type) * X)
}

step_probs <- function(x, dprev, N) {
  r  <- N - dprev
  a  <- (dprev - x) / r
  p2 <- a^2
  p1 <- 2 * a * (1 - a) + (1 - a) / r
  p0 <- (1 - a) * (1 - a - 1 / r)
  c(p0, p1, p2)
}

null_moments_exact <- function(N, k, w) {
  m0 <- c(1, rep(0, k)); m1 <- rep(0, k + 1); m2 <- rep(0, k + 1)
  for (d in seq_len(k)) {
    n0 <- n1 <- n2 <- rep(0, k + 1)
    for (x in 0:(d - 1)) {
      if (m0[x + 1] == 0) next
      pr <- step_probs(x, d - 1, N)
      for (inc in 0:2) {
        xn <- x + inc
        if (xn > d) next
        a  <- w[d] * xn
        q  <- pr[inc + 1]
        n0[xn + 1] <- n0[xn + 1] + q * m0[x + 1]
        n1[xn + 1] <- n1[xn + 1] + q * (m1[x + 1] + a * m0[x + 1])
        n2[xn + 1] <- n2[xn + 1] + q * (m2[x + 1] + 2 * a * m1[x + 1] + a^2 * m0[x + 1])
      }
    }
    m0 <- n0; m1 <- n1; m2 <- n2
  }
  mu <- sum(m1); v <- sum(m2) - mu^2
  list(mean = mu, sd = sqrt(max(v, 0)), pX_k = m0)
}

null_dist_dp <- function(N, k, w, mom, n_bins = N_BINS) {
  W     <- rev(cumsum(rev(w)))
  t_max <- sum(w * seq_len(k))
  m_up  <- qhyper(1e-12, k, N - k, k, lower.tail = FALSE)
  t_cap <- min(t_max, max(m_up, 1) * W[1])
  h     <- t_cap / (n_bins - 1)
  s1    <- round(W / h); s2 <- round(2 * W / h)
  P     <- matrix(0, k + 1, n_bins)
  P[1, 1] <- 1
  shift_cols <- function(M, s) {
    if (s == 0) return(M)
    out <- matrix(0, nrow(M), n_bins)
    if (s < n_bins) out[, (1 + s):n_bins] <- M[, 1:(n_bins - s), drop = FALSE]
    keep <- max(1, n_bins - s + 1)
    out[, n_bins] <- out[, n_bins] + rowSums(M[, keep:n_bins, drop = FALSE])
    out
  }
  for (d in seq_len(k)) {
    x   <- 0:(d - 1)
    r   <- N - (d - 1)
    a   <- (d - 1 - x) / r
    p0  <- (1 - a) * (1 - a - 1 / r)
    p1  <- 2 * a * (1 - a) + (1 - a) / r
    p2  <- a^2
    Pr  <- P[x + 1, , drop = FALSE]
    Q   <- matrix(0, k + 1, n_bins)
    Q[x + 1, ] <- Q[x + 1, , drop = FALSE] + p0 * Pr
    Q[x + 2, ] <- Q[x + 2, , drop = FALSE] + p1 * shift_cols(Pr, s1[d])
    ok2 <- which(x + 2 <= d)
    if (length(ok2) > 0)
      Q[x[ok2] + 3, ] <- Q[x[ok2] + 3, , drop = FALSE] +
        p2[ok2] * shift_cols(Pr[ok2, , drop = FALSE], s2[d])
    P <- Q
  }
  list(value = (0:(n_bins - 1)) * h, prob = colSums(P),
       h = h, s1 = s1, s2 = s2, n_bins = n_bins,
       tail_mass = sum(P[, n_bins]))
}

score_grid <- function(X, dist) {
  X     <- matrix(X, ncol = length(dist$s1))
  Delta <- X - cbind(0, X[, -ncol(X), drop = FALSE])
  cells <- (Delta == 1) %*% dist$s1 + (Delta == 2) %*% dist$s2
  as.vector(pmin(cells, dist$n_bins - 1)) * dist$h
}

pvalue_dp <- function(t_hat, dist) {
  cs <- rev(cumsum(rev(dist$prob)))
  cs[pmin(round(t_hat / dist$h) + 1, dist$n_bins)]
}

quantile_dp <- function(prob_level, dist) {
  cdf <- cumsum(dist$prob)
  sapply(prob_level, function(a) dist$value[which(cdf >= a - 1e-12)[1]])
}

null_paths_mc <- function(N, k, B) {
  t(replicate(B, overlap_path_A(sample.int(N, k), sample.int(N, k), k)))
}

ks_dp_mc <- function(dist, t_hat_mc) {
  cdf  <- cumsum(dist$prob)
  cell <- round(t_hat_mc / dist$h) + 1
  tab  <- tabulate(cell, nbins = dist$n_bins) / length(cell)
  max(abs(cdf - cumsum(tab)))
}

