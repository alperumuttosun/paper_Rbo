# ---- step13: rho test versus a raw-agreement test ----
REDO_STEP13 <- FALSE  # TRUE recomputes the step
R_13        <- 100    # data sets per scenario (parallel)
R_13_SER    <- 40     # data sets per scenario if run serially
B_13        <- 49     # permutations per data set
f13a <- "step13_rho_vs_raw_sim.csv"

glob_stat2_n <- function(labs, spl, btw, by_lab = FALSE) {      # both statistics from the same lists
  ll <- lapply(labs, lab_lists_n, spl = spl, btw = btw); L <- length(labs)
  R <- matrix(NA, L, L); E <- matrix(NA, L, L)
  for (i in 1:(L - 1)) for (j in (i + 1):L) {
    E[i, j] <- E[j, i] <- mean(mapply(rbo_lists, ll[[i]]$pool, ll[[j]]$pool))   # raw between-laboratory RBO
    R[i, j] <- R[j, i] <- E[i, j] / sqrt(ll[[i]]$C * ll[[j]]$C)                 # disattenuated rho
  }
  out <- c(rho = mean(R[upper.tri(R)]), E = mean(E[upper.tri(E)]))
  if (by_lab) out <- c(out, worst_rho = which.min(rowMeans(R, na.rm = TRUE)),  # laboratory with the lowest mean rho
                       worst_E = which.min(rowMeans(E, na.rm = TRUE)))         # laboratory with the lowest mean raw RBO
  out
}

if (!REDO_STEP13 && file.exists(f13a)) {
  cat("step13 outputs exist, skipping (set REDO_STEP13 <- TRUE to rerun).\n")
} else {
  t13 <- Sys.time(); set.seed(20261104)
  par13 <- readRDS(f_par)
  sc13 <- list(                                                    # noise factors and kappa per scenario
    null              = list(noise = rep(1, 6),                         kap = 0),
    unequal_noise     = list(noise = c(0.8, 0.9, 1, 1, 1.1, 1.25),      kap = 0),
    one_noisy_lab_1.5 = list(noise = c(1, 1, 1, 1, 1, 1.5),             kap = 0),
    kappa_0.5         = list(noise = rep(1, 6),                         kap = 0.5))
  res13 <- if (file.exists(f13a) && !REDO_STEP13) read.csv(f13a, stringsAsFactors = FALSE) else NULL
  for (bn in c("MAQC", "SEQC")) {
    cp13 <- par13[[paste(bn, "A-B")]]
    if (is.null(cp13)) { cat("13: no parameters for", bn, "\n"); next }
    cp13 <- prefilter(cp13, M_REP, median(cp13$sigma^2)); n13 <- n_rep_of[[bn]]
    for (sn in names(sc13)) {
      if (!is.null(res13) && any(res13$base == bn & res13$scenario == sn)) next
      s13 <- sc13[[sn]]
      one13 <- function(r) {                                       # one simulated data set, both tests
        labs_s <- lapply(1:6, function(l) sim_lab(cp13, n13, s13$kap * cp13$sigma, s13$noise[l]))
        obs  <- glob_stat2_n(labs_s, SPL10, BTW10, by_lab = TRUE)
        perm <- replicate(B_13, glob_stat2_n(permute_labs(labs_s), SPL10, BTW10))
        c(T_rho = obs[["rho"]], T_E = obs[["E"]],
          p_rho = (1 + sum(perm["rho", ] <= obs[["rho"]])) / (B_13 + 1),
          p_E   = (1 + sum(perm["E", ] <= obs[["E"]])) / (B_13 + 1),
          lab6_worst_rho = obs[["worst_rho"]] == 6, lab6_worst_E = obs[["worst_E"]] == 6)
      }
      if (is.null(res13) && bn == "MAQC" && sn == "null") {        # time one data set and print an estimate
        tt <- system.time(one13(0))[["elapsed"]]
        n_par <- max(1, N_CORES); n_run <- if (n_par > 1) R_13 else R_13_SER
        cat(sprintf("13: one data set took %.1f s; estimated total %.0f-%.0f min (%d cores)\n",
                    tt, tt * n_run * 8 / n_par / 60 * 0.7, tt * n_run * 8 / n_par / 60 * 1.3, n_par))
      }
      cat(sprintf("13: %s %s (%d data sets x %d permutations)...\n", bn, sn, R_13, B_13))
      v <- do.call(rbind, run_reps(R_13, one13, n_serial = R_13_SER))
      res13 <- rbind(res13, data.frame(base = bn, scenario = sn, n_sim = nrow(v), B_perm = B_13,
        mean_T_rho = mean(v[, "T_rho"]), mean_T_E = mean(v[, "T_E"]),
        reject05_rho = mean(v[, "p_rho"] <= 0.05), reject05_E = mean(v[, "p_E"] <= 0.05),
        reject10_rho = mean(v[, "p_rho"] <= 0.10), reject10_E = mean(v[, "p_E"] <= 0.10),
        lab6_lowest_rho = mean(v[, "lab6_worst_rho"]), lab6_lowest_E = mean(v[, "lab6_worst_E"])))
      write.csv(res13, f13a, row.names = FALSE)                    # saved after every scenario
    }
  }
  print(res13, digits = 3)
  cat(sprintf("step13 done. Time: %.1f min\n", as.numeric(difftime(Sys.time(), t13, units = "mins"))))
}
cat("step13 output files:", f13a, "\n")

# ---- step14: TIF copies of the figures for journal submission ----
REDO_STEP14 <- FALSE  # TRUE rewrites the TIF files
TIF_DPI     <- 1600   # same resolution as the PNG files
tif_files <- file.path(fig_dir, paste0("Fig", 1:5, ".tif"))

png_to_tif_A <- function(fp, ft) {                              # method A: magick package
  if (!requireNamespace("magick", quietly = TRUE)) install.packages("magick", repos = "https://cloud.r-project.org")
  im <- magick::image_read(fp)
  magick::image_write(im, ft, format = "tiff", compression = "LZW", density = paste0(TIF_DPI, "x", TIF_DPI))
  TRUE
}
png_to_tif_B <- function(fp, ft) {                              # method B: base R tiff device
  if (!requireNamespace("png", quietly = TRUE)) install.packages("png", repos = "https://cloud.r-project.org")
  im <- png::readPNG(fp); h <- dim(im)[1]; w <- dim(im)[2]
  tiff(ft, width = w, height = h, units = "px", res = TIF_DPI, compression = "lzw")
  par(mar = c(0, 0, 0, 0)); plot.new(); plot.window(c(0, 1), c(0, 1), xaxs = "i", yaxs = "i")
  rasterImage(im, 0, 0, 1, 1, interpolate = FALSE); dev.off()
  TRUE
}

if (!REDO_STEP14 && all(file.exists(tif_files))) {
  cat("step14 outputs exist, skipping (set REDO_STEP14 <- TRUE to rerun).\n")
} else {
  for (i in 1:5) {
    fp <- file.path(fig_dir, paste0("Fig", i, ".png")); ft <- tif_files[i]
    if (!file.exists(fp)) { cat("step14: missing", fp, "\n"); next }
    ok <- tryCatch(png_to_tif_A(fp, ft), error = function(e) { cat("  method A failed:", conditionMessage(e), "\n"); FALSE })
    if (!ok) ok <- tryCatch(png_to_tif_B(fp, ft), error = function(e) { cat("  method B failed:", conditionMessage(e), "\n"); FALSE })
    cat(sprintf("step14: Fig%d.tif %s (%.1f MB)\n", i, if (ok) "written" else "FAILED",
                if (file.exists(ft)) file.size(ft) / 1e6 else 0))
  }
}
