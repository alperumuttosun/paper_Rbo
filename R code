    mA <- tryCatch(maqc_way_A(), error = function(e) e)
    if (inherits(mA, "error")) add_check("MAQC", "A", "FAILED", msg = conditionMessage(mA)) else
      add_check("MAQC", "A", "OK", nrow(mA$expr), ncol(mA$expr), length(unique(mA$pheno$site)))
    mB <- tryCatch(maqc_way_B(), error = function(e) e)
    if (inherits(mB, "error")) add_check("MAQC", "B", "FAILED", msg = conditionMessage(mB)) else
      add_check("MAQC", "B", "OK", nrow(mB$expr), ncol(mB$expr), length(unique(na.omit(mB$pheno$site))))
    maqc <- if (!inherits(mB, "error")) mB else if (!inherits(mA, "error")) mA else NULL
    if (!is.null(maqc)) saveRDS(maqc, f_maqc)
  }

  if (file.exists(f_seqc)) {
    seqc <- readRDS(f_seqc); add_check("SEQC", seqc$way, "CACHE", NA, NA, length(seqc$ilm), "read from cache")
  } else {
    seqc <- tryCatch(seqc_way_A(), error = function(e) e)
    if (inherits(seqc, "error")) {
      add_check("SEQC", "A", "FAILED", msg = conditionMessage(seqc))
      seqc <- tryCatch(seqc_way_B(), error = function(e) e)
      if (inherits(seqc, "error")) { add_check("SEQC", "B", "FAILED", msg = conditionMessage(seqc)); seqc <- NULL }
      else add_check("SEQC", "B", "OK", nrow(seqc$ilm[[1]]), sum(sapply(seqc$ilm, ncol)), length(seqc$ilm))
    } else add_check("SEQC", "A", "OK", nrow(seqc$ilm[[1]]), sum(sapply(seqc$ilm, ncol)), length(seqc$ilm))
    if (!is.null(seqc)) saveRDS(seqc, f_seqc)
  }

  write.csv(do.call(rbind, check_rows), f_check, row.names = FALSE)
  write.csv(if (!is.null(maqc)) maqc_design(maqc) else data.frame(note = "MAQC could not be loaded"),
            f_mdes, row.names = FALSE)
  sd <- if (!is.null(seqc)) seqc_design(seqc) else NULL
  write.csv(if (!is.null(sd)) sd else data.frame(note = "SEQC could not be loaded or column names could not be parsed"),
            f_sdes, row.names = FALSE)
  print(do.call(rbind, check_rows))
}

