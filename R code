    write.csv(cl6, f10g, row.names = FALSE); print(cl6, digits = 3)
  }
  K_LIST <- K0; P_RBO <- P0
  cat(sprintf("step10 bitti. Süre: %.1f dakika\n", as.numeric(difftime(Sys.time(), t10, units = "mins"))))
}
