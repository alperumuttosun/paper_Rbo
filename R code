    set.seed(99); full <- rho_pair(l1f, l2f, cf$ranking, s0, SPL_REAL, BTW_REAL)
    set.seed(99); filt <- rho_pair(sub_lab(labs[[1]], g1, g2, keep), sub_lab(labs[[2]], g1, g2, keep), cf$ranking, s0, SPL_REAL, BTW_REAL)
    fchk[[length(fchk) + 1]] <- data.frame(cf, n_genes_full = nrow(l1f$A), n_genes_kept = length(keep),
                                           rho_full = full[["rho"]], rho_filtered = filt[["rho"]],
                                           C1_full = full[["C1"]], C1_filtered = filt[["C1"]])
    cv <- curves[curves$dataset == cf$dataset & curves$contrast == cf$contrast & curves$ranking == cf$ranking, ]
    pr <- combn(names(labs), 2)
    for (j in seq_len(ncol(pr))) {
      cat(sprintf("permütasyon testi: %s %s %s %s-%s\n", cf$dataset, cf$contrast, cf$ranking, pr[1, j], pr[2, j]))
      v  <- perm_test_real(sub_lab(labs[[pr[1, j]]], g1, g2, keep), sub_lab(labs[[pr[2, j]]], g1, g2, keep), cf$ranking, s0)
      rel <- min(v[["C1"]], v[["C2"]]) >= RHO_MIN_C6
      kc <- if (rel && nrow(cv) > 0) kappa_ci(v[["rho"]], cv) else
        c(kappa_hat = NA, kappa_lo = NA, kappa_hi = NA, kappa_beyond_grid = NA, rho_lo = NA, rho_hi = NA)
      rows[[length(rows) + 1]] <- data.frame(cf, lab1 = pr[1, j], lab2 = pr[2, j],
        C1 = v[["C1"]], C2 = v[["C2"]], E = v[["E"]], rho_hat = v[["rho"]], reliable = rel,
        p_perm = v[["p"]], t(kc))
    }
  }
  res <- do.call(rbind, rows)
  res$p_bh <- ave(res$p_perm, res$dataset, res$contrast, res$ranking,
                  FUN = function(p) p.adjust(p, method = "BH"))   # çoklu test düzeltmesi (Benjamini-Hochberg)
  write.csv(res, f_pairs, row.names = FALSE)                       # çıktı 1
  write.csv(do.call(rbind, fchk), f_fchk, row.names = FALSE)       # çıktı 3
  print(res[, c("dataset", "contrast", "ranking", "lab1", "lab2", "rho_hat", "p_perm", "p_bh", "kappa_hat")], digits = 3)
  cat(sprintf("step06 bitti. Süre: %.1f dakika\n", as.numeric(difftime(Sys.time(), t6, units = "mins"))))
}

