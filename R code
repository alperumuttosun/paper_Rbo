    rect(i - 0.5, y - 0.5, i + 0.5, y + 0.5, col = fill, border = NA)
    if (i != j) text(i, y, sprintf("%.2f", M[j, i]), cex = 0.95, font = 2,
                     col = ifelse(abs(M[j, i]) > 0.6, "white", "black"))
  }
  segments(1.5:(n - 0.5), 0.5, 1.5:(n - 0.5), n + 0.5, lwd = LW)
