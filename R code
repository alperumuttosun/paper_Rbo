  curves <- do.call(rbind, curves); write.csv(curves, f_curves, row.names = FALSE)   # çıktı 2

  # (a) + (c) gerçek çiftler
  rows <- list(); fchk <- list()
  for (i in seq_len(nrow(configs6))) {
