# --- 3a) Yardımcı fonksiyonlar ---
check_rows <- list()                                        # yol denemelerinin kaydı
add_check <- function(dataset, way, status, n_feat = NA, n_col = NA, n_site = NA, msg = "") {
  check_rows[[length(check_rows) + 1]] <<- data.frame(      # tabloya bir satır ekle
    dataset = dataset, way = way, status = status,          # veri seti, yol, durum (OK / FAILED / CACHE)
    n_features = n_feat, n_columns = n_col, n_sites = n_site,  # gen/prob sayısı, sütun sayısı, laboratuvar sayısı
    message = substr(gsub("[\r\n]+", " ", msg), 1, 300))    # hata mesajı (kısaltılmış)
}

bioc_ok <- function(pkg) {                                  # Bioconductor paketi kurulu mu? değilse kurmayı dene
  if (requireNamespace(pkg, quietly = TRUE)) return(TRUE)   # zaten kuruluysa tamam
  tryCatch({
    if (!requireNamespace("BiocManager", quietly = TRUE))   # BiocManager yoksa
      install.packages("BiocManager")                       #   CRAN'dan kur
    BiocManager::install(pkg, ask = FALSE, update = FALSE)  # paketi kur (diğer paketleri güncelleme)
  }, error = function(e) NULL)                              # kurulum hatası olursa sessizce geç
  requireNamespace(pkg, quietly = TRUE)                     # sonuç: kuruldu mu?
}

download_tmp <- function(url) {                             # dosyayı geçici klasöre indir (proje klasörünü kirletmez)
  dest <- file.path(tempdir(), basename(url))               # geçici dosya yolu
  if (!file.exists(dest)) download.file(url, dest, mode = "wb", quiet = TRUE)  # yoksa indir
  dest                                                      # dosya yolunu döndür
}

list_remote_files <- function(dir_url) {                    # GEO klasöründeki dosya adlarını listele
  html <- readLines(dir_url, warn = FALSE)                  # klasör sayfasını oku
  m <- regmatches(html, gregexpr('href="[^"?/]+"', html))   # bağlantıları bul
  unique(gsub('href="|"', "", unlist(m)))                   # yalnızca dosya adlarını döndür
}

# --- 3b) GEO series matrix dosyasını temel R ile oku (Yol B) ---
read_series_matrix <- function(gz_file) {
  L <- readLines(gzfile(gz_file), warn = FALSE)             # tüm satırları oku
  field <- function(tag) {                                  # "!Sample_xxx" satırından değerleri çek
    x <- L[startsWith(L, tag)]                              # o etiketle başlayan satırlar
    if (length(x) == 0) return(NULL)                        # yoksa NULL
    lapply(x, function(s) gsub('"', "", strsplit(s, "\t")[[1]][-1]))  # her satırı sekmeden böl, tırnakları sil
  }
  title <- field("!Sample_title")[[1]]                      # örnek başlıkları
  gsm   <- field("!Sample_geo_accession")[[1]]              # GSM numaraları
  ch    <- field("!Sample_characteristics_ch1")             # örnek özellikleri (birden çok satır olabilir)
  chars <- if (is.null(ch)) rep("", length(gsm)) else       # özellikleri tek metinde birleştir
    apply(do.call(cbind, ch), 1, paste, collapse = "; ")
  b <- which(L == "!series_matrix_table_begin")             # veri tablosunun başı
  e <- which(L == "!series_matrix_table_end")               # veri tablosunun sonu
  tab <- read.delim(text = L[(b + 1):(e - 1)], check.names = FALSE, quote = '"')  # tabloyu oku
  X <- as.matrix(tab[, -1, drop = FALSE]); rownames(X) <- tab[[1]]   # ilk sütun prob adı, gerisi ifade değerleri
  list(expr = X, info = data.frame(sample_id = gsm, title = title, chars = chars))  # ifade matrisi + örnek bilgisi
}

parse_maqc_titles <- function(info) {                       # başlıktan laboratuvar, örnek (A-D), tekrar çıkar
  s <- paste(info$title, info$chars)                        # başlık + özellikler
  m <- regmatches(s, regexec("AFX[_ ]?([0-9]+)[_ ]?([A-D])[_ ]?([0-9]+)", s))  # ör. "AFX_1_A1"
  get <- function(i) sapply(m, function(z) if (length(z) == 4) z[i] else NA)   # eşleşme yoksa NA
  data.frame(sample_id = info$sample_id, site = get(2), samp = get(3), repl = get(4))
}

# --- 3c) MAQC: Yol A (MAQCsubset paketi) ---
maqc_way_A <- function() {
  if (!bioc_ok("Biobase") || !bioc_ok("MAQCsubset")) stop("MAQCsubset/Biobase kurulamadı")
  suppressPackageStartupMessages(library(Biobase))          # ExpressionSet sınıfı için
  e <- new.env()                                            # verinin yükleneceği boş ortam
  data("afxsubRMAES", package = "MAQCsubset", envir = e)    # Affymetrix alt kümesi (RMA, 54675 prob x 24 örnek)
  es <- e$afxsubRMAES                                       # ExpressionSet nesnesi
  X  <- Biobase::exprs(es)                                  # ifade matrisi
  pd <- Biobase::pData(es)                                  # örnek bilgileri
  list(expr = X,
       pheno = data.frame(sample_id = colnames(X), site = as.character(pd$site),
                          samp = as.character(pd$samp), repl = as.character(pd$repl)),
       source = "MAQCsubset::afxsubRMAES (RMA)", way = "A")
}

# --- 3d) MAQC: Yol B (GEO GSE5350, GPL570 series matrix, temel R) ---
maqc_way_B <- function() {
  gz <- tryCatch(download_tmp(url_maqc_B), error = function(e) NULL)  # önce bilinen dosya adını dene
  if (is.null(gz)) {                                        # olmazsa klasörü listele
    fl <- list_remote_files(url_maqc_dir)                   # klasördeki dosyalar
    fl <- fl[grepl("GPL570", fl) & grepl("series_matrix", fl)]  # GPL570 (Affymetrix) matrisi
    if (length(fl) == 0) stop("GSE5350 içinde GPL570 series matrix bulunamadı")
    gz <- download_tmp(paste0(url_maqc_dir, fl[1]))         # bulunanı indir
  }
  sm <- read_series_matrix(gz)                              # dosyayı oku
  ph <- parse_maqc_titles(sm$info)                          # laboratuvar/örnek/tekrar çıkar
  if (all(is.na(ph$site))) {                                # başlıklar beklenen biçimde değilse
    write.csv(head(sm$info, 30), "step03_maqc_pheno_head.csv", row.names = FALSE)  # bana göndermen için örnek
    stop("Örnek başlıkları ayrıştırılamadı; step03_maqc_pheno_head.csv dosyasını gönderin")
  }
  list(expr = sm$expr, pheno = ph, source = "GEO GSE5350 GPL570 series matrix", way = "B")
}

# --- 3e) SEQC: Yol A (seqc paketi; Illumina RefSeq gen sayımları + TaqMan) ---
seqc_way_A <- function() {
  if (!bioc_ok("seqc")) stop("seqc paketi kurulamadı")
  objs <- paste0("ILM_refseq_gene_", seqc_sites)            # 6 Illumina merkezinin tablo adları
  getd <- function(o) tryCatch(getExportedValue("seqc", o), # önce doğrudan eriş
    error = function(e) { en <- new.env(); data(list = o, package = "seqc", envir = en); en[[o]] })  # olmazsa data()
  ilm <- setNames(lapply(objs, getd), seqc_sites)           # her merkezin sayım tablosu
  list(ilm = ilm, taqman = getd("taqman"), source = "Bioconductor seqc (RefSeq gene counts)", way = "A")
}

# --- 3f) SEQC: Yol B (GEO GSE47774 ek dosyaları, temel R) ---
seqc_way_B <- function() {
  fl <- list_remote_files(url_seqc_dir)                     # GEO'daki ek dosyaların listesi
  write.csv(data.frame(file = fl), "step03_seqc_geo_files.csv", row.names = FALSE)  # listeyi kaydet (kontrol için)
  fl <- fl[grepl("ILM", fl, ignore.case = TRUE)]            # yalnızca Illumina dosyaları
  site_of <- sapply(fl, function(f) {                       # dosya adındaki merkez kodunu bul
    hit <- seqc_sites[sapply(seqc_sites, grepl, x = f)]; if (length(hit)) hit[1] else NA })
  fl <- fl[!is.na(site_of)]; site_of <- site_of[!is.na(site_of)]  # merkez kodu bulunanları tut
  if (length(fl) == 0) stop("GSE47774'te Illumina merkez dosyası bulunamadı; step03_seqc_geo_files.csv gönderin")
  keep <- !duplicated(site_of)                              # her merkezden bir dosya
  ilm <- lapply(fl[keep], function(f) read.delim(download_tmp(paste0(url_seqc_dir, f)), check.names = FALSE))  # indir+oku
  names(ilm) <- site_of[keep]
  list(ilm = ilm, taqman = NULL, source = "GEO GSE47774 supplementary", way = "B")
}

# --- 3g) Tasarım tabloları ---
maqc_design <- function(m) {                                # laboratuvar x örnek başına tekrar sayısı
  ph <- m$pheno[!is.na(m$pheno$site), ]                     # ayrıştırılabilen örnekler
  d  <- aggregate(sample_id ~ site + samp, data = ph, FUN = length)  # her hücrede kaç tekrar
  names(d)[3] <- "n_replicates"
  cbind(source = m$source, way = m$way, n_probes = nrow(m$expr), d)
}

parse_lib_cols <- function(cn) {                            # "A_1_L01_FlowCellA" -> örnek, tekrar, şerit
  m <- regmatches(cn, regexec("(?:^|_)([A-F])_([0-9]+)_(L[0-9]+|R[0-9]+)", cn, perl = TRUE))  # desen
  ok <- sapply(m, length) == 4                              # eşleşen sütunlar = kütüphane sütunları
  data.frame(col = cn[ok], samp = sapply(m[ok], `[`, 2),
             repl = sapply(m[ok], `[`, 3), lane = sapply(m[ok], `[`, 4))
}

seqc_design <- function(s) {                                # her merkez x örnek: kaç bağımsız tekrar, kaç şerit sütunu
  out <- list()
  for (site in names(s$ilm)) {
    tb <- s$ilm[[site]]                                     # o merkezin tablosu
    pc <- parse_lib_cols(colnames(tb))                      # kütüphane sütunlarını çöz
    if (nrow(pc) == 0) next                                 # sütun adı beklenmedikse atla
    is_ercc <- if ("IsERCC" %in% names(tb)) as.logical(tb$IsERCC) else rep(FALSE, nrow(tb))  # spike-in satırları
    agg <- aggregate(lane ~ samp, data = pc, FUN = length)  # örnek başına şerit sütunu sayısı
    rep <- aggregate(repl ~ samp, data = pc, FUN = function(z) length(unique(z)))  # örnek başına tekrar sayısı
    out[[site]] <- data.frame(platform = "Illumina", site = site, samp = agg$samp,
                              n_replicates = rep$repl, n_lane_columns = agg$lane,
                              n_genes = sum(!is_ercc), source = s$source, way = s$way)
  }
  if (!is.null(s$taqman)) {                                 # TaqMan: "A1_value" sütunları
    tv <- grep("_value$", colnames(s$taqman), value = TRUE) # değer sütunları
    sm <- substr(tv, 1, 1)                                  # örnek harfi
    out[["TaqMan"]] <- data.frame(platform = "TaqMan", site = "TaqMan",
                                  samp = names(table(sm)), n_replicates = as.vector(table(sm)),
                                  n_lane_columns = NA, n_genes = nrow(s$taqman),
                                  source = s$source, way = s$way)
  }
  do.call(rbind, out)
}

# --- 3h) Çalıştır ---
if (!REDO_STEP03 && all(file.exists(c(f_check, f_mdes, f_sdes)))) {
  cat("step03 çıktıları mevcut, atlanıyor (yeniden için REDO_STEP03 <- TRUE).\n")
} else {

  # MAQC: önbellek varsa oradan; yoksa iki yol da denenir (A küçük alt küme, B tam veri), en iyisi saklanır
  if (file.exists(f_maqc)) {
    maqc <- readRDS(f_maqc); add_check("MAQC", maqc$way, "CACHE", nrow(maqc$expr), ncol(maqc$expr),
                                       length(unique(na.omit(maqc$pheno$site))), "önbellekten okundu")
  } else {
    mA <- tryCatch(maqc_way_A(), error = function(e) e)     # Yol A
    if (inherits(mA, "error")) add_check("MAQC", "A", "FAILED", msg = conditionMessage(mA)) else
      add_check("MAQC", "A", "OK", nrow(mA$expr), ncol(mA$expr), length(unique(mA$pheno$site)))
    mB <- tryCatch(maqc_way_B(), error = function(e) e)     # Yol B
    if (inherits(mB, "error")) add_check("MAQC", "B", "FAILED", msg = conditionMessage(mB)) else
      add_check("MAQC", "B", "OK", nrow(mB$expr), ncol(mB$expr), length(unique(na.omit(mB$pheno$site))))
    maqc <- if (!inherits(mB, "error")) mB else if (!inherits(mA, "error")) mA else NULL  # tam veri öncelikli
    if (!is.null(maqc)) saveRDS(maqc, f_maqc)               # bir daha indirmemek için sakla
  }

  # SEQC: önbellek varsa oradan; yoksa önce Yol A, olmazsa Yol B (dosyalar büyük, iki kez indirmeyelim)
  if (file.exists(f_seqc)) {
    seqc <- readRDS(f_seqc); add_check("SEQC", seqc$way, "CACHE", NA, NA, length(seqc$ilm), "önbellekten okundu")
  } else {
    seqc <- tryCatch(seqc_way_A(), error = function(e) e)   # Yol A
    if (inherits(seqc, "error")) {
      add_check("SEQC", "A", "FAILED", msg = conditionMessage(seqc))
      seqc <- tryCatch(seqc_way_B(), error = function(e) e) # Yol B
      if (inherits(seqc, "error")) { add_check("SEQC", "B", "FAILED", msg = conditionMessage(seqc)); seqc <- NULL }
      else add_check("SEQC", "B", "OK", nrow(seqc$ilm[[1]]), sum(sapply(seqc$ilm, ncol)), length(seqc$ilm))
    } else add_check("SEQC", "A", "OK", nrow(seqc$ilm[[1]]), sum(sapply(seqc$ilm, ncol)), length(seqc$ilm))
    if (!is.null(seqc)) saveRDS(seqc, f_seqc)               # bir daha indirmemek için sakla
  }

  # tabloları yaz
  write.csv(do.call(rbind, check_rows), f_check, row.names = FALSE)                  # çıktı 1
  write.csv(if (!is.null(maqc)) maqc_design(maqc) else data.frame(note = "MAQC yüklenemedi"),
            f_mdes, row.names = FALSE)                                               # çıktı 2
  sd <- if (!is.null(seqc)) seqc_design(seqc) else NULL
  write.csv(if (!is.null(sd)) sd else data.frame(note = "SEQC yüklenemedi veya sütun adları çözülemedi"),
            f_sdes, row.names = FALSE)                                               # çıktı 3
  print(do.call(rbind, check_rows))                                                  # ekrana özet
}


# ---------------------------------------------------------------------
# step04: KALİBRASYON + İLK BAKIŞ (gürültü tavanı)
#  (a) Gerçek veriden sentetik veri parametreleri: her gen için gerçek etki (mu), gürültü (sigma),
#      laboratuvar etkisi (tau)  -> step05'te sahte laboratuvarlar bunlarla üretilecek
#  (b) Gerçek veride ilk bakış: laboratuvar içi tavan C, laboratuvarlar arası E, oran rho = E / sqrt(C1*C2)
# ---------------------------------------------------------------------
REDO_STEP04 <- FALSE        # TRUE: step04 yeniden hesaplanır (v2 sonuçları mevcut, atlanır)
K_LIST      <- 100          # liste uzunluğu (ilk 100 gen)
P_RBO       <- 0.98         # RBO ağırlık parametresi
M_REP       <- 2            # her listede örnek başına kullanılan tekrar sayısı (laboratuvar içinde 2+2 bölmek için)
MAX_SPLITS  <- 200          # laboratuvar içi bölme sayısı üst sınırı (az ise hepsi = Yol A, çoksa rastgele = Yol B)
N_BETWEEN   <- 200          # laboratuvarlar arası rastgele çekiliş sayısı (v2: 60 -> 200, Monte Carlo hatası azalsın)
RHO_MIN_C   <- 0.10         # rho yalnızca iki tavan da >= 0.10 ise "güvenilir" sayılır (tavan sıfıra yakınsa oran patlar)
DROP_VENDOR <- TRUE         # SEQC: 5. tekrar satıcı (vendor) tarafından hazırlanmış farklı protokol -> çıkar

f_cal  <- "step04_calibration.csv"                          # çıktı 1: sentetik veri parametreleri (özet)
f_ceil <- "step04_ceiling_by_lab.csv"                       # çıktı 2: laboratuvar içi tavan C
f_betw <- "step04_between_labs.csv"                         # çıktı 3: laboratuvar çiftleri: E, C1, C2, rho
f_par  <- "step04_calib_params.rds"                         # gen düzeyinde parametreler (step05 için)

# --- 4a) Veriyi standart biçime getir: lab -> örnek (A,B,C,D) -> gen x tekrar matrisi (log ölçek) ---
prep_maqc <- function(m) {
  ph <- m$pheno; ok <- !is.na(ph$site) & ph$samp %in% c("A", "B", "C", "D")  # ayrıştırılmış A-D örnekleri
  ph <- ph[ok, ]; X <- m$expr[, match(ph$sample_id, colnames(m$expr)), drop = FALSE]  # sütunları eşleştir
  X <- matrix(as.numeric(X), nrow(X), dimnames = dimnames(X))  # sayıya çevir
  if (median(X, na.rm = TRUE) > 20) X <- log2(pmax(X, 1))   # ham sinyal ise log2'ye çevir (RMA zaten log)
  X <- X[rowSums(is.na(X)) == 0, , drop = FALSE]            # eksik değerli probları at
  am <- rowMeans(X); X <- X[am > quantile(am, 0.25), , drop = FALSE]  # en düşük ifadeli %25'i at (gürültü)
  labs <- lapply(sort(unique(ph$site)), function(s)         # her laboratuvar için
    setNames(lapply(c("A", "B", "C", "D"), function(g) X[, ph$site == s & ph$samp == g, drop = FALSE]),
             c("A", "B", "C", "D")))                        # örnek başına gen x tekrar matrisi
  names(labs) <- paste0("lab", sort(unique(ph$site)))
  labs
}

prep_seqc <- function(s) {
  cnt <- list(); key <- NULL
  for (site in names(s$ilm)) {                              # her merkez için
    tb <- s$ilm[[site]]
    if ("IsERCC" %in% names(tb)) tb <- tb[!as.logical(tb$IsERCC), ]  # spike-in satırlarını çıkar
    pc <- parse_lib_cols(colnames(tb)); pc <- pc[pc$samp %in% c("A", "B", "C", "D"), ]  # A-D kütüphaneleri
    if (DROP_VENDOR) pc <- pc[pc$repl != "5", ]             # v2: satıcı kütüphanesini (tekrar 5) çıkar -> her merkezde 4 tekrar
    M  <- as.matrix(tb[, pc$col]); storage.mode(M) <- "double"  # şerit sütunları
    lib <- paste(pc$samp, pc$repl, sep = "_")               # kütüphane adı = örnek_tekrar
    Cm <- t(rowsum(t(M), lib))                              # aynı kütüphanenin şeritlerini topla
    rownames(Cm) <- paste(tb$EntrezID, tb$Symbol)           # gen anahtarı
    Cm <- Cm[!duplicated(rownames(Cm)), , drop = FALSE]     # tekrarlanan gen adlarından yalnızca ilkini tut
    cnt[[site]] <- Cm
    key <- if (is.null(key)) rownames(Cm) else intersect(key, rownames(Cm))  # ortak genler
  }
  all <- do.call(cbind, lapply(cnt, function(Cm) Cm[key, , drop = FALSE]))  # tüm kütüphaneler yan yana
  cpm <- t(t(all) / colSums(all)) * 1e6                     # milyonda okuma (CPM)
  keep <- rowMeans(cpm) >= 1                                # ortalama CPM >= 1 olan genler (düşük ifadeyi at)
  labs <- lapply(names(cnt), function(site) {
    Cm <- cnt[[site]][key[keep], , drop = FALSE]
    L  <- log2((Cm + 2) / (colSums(cnt[[site]][key, ]) + 4) * 1e6)    # v2: log2-CPM, önsel sayı 2 (edgeR varsayılanına benzer; düşük sayımlı genlerin aşırı LFC gürültüsünü azaltır)
    smp <- sub("_.*", "", colnames(L))                      # kütüphanenin örnek harfi
    setNames(lapply(c("A", "B", "C", "D"), function(g) L[, smp == g, drop = FALSE]), c("A", "B", "C", "D"))
  })
  names(labs) <- names(cnt)
  labs
}

# --- 4b) Gen skorları ve ilk-k listesi ---
score_fun <- function(xa, xb, ranking) {
  d <- rowMeans(xa) - rowMeans(xb)                          # log kat değişimi (LFC)
  if (ranking == "LFC") return(d)                           # sıralama 1: kat değişimi
  s2 <- (rowSums((xa - rowMeans(xa))^2) + rowSums((xb - rowMeans(xb))^2)) /
        (ncol(xa) + ncol(xb) - 2)                           # birleştirilmiş varyans
  d / sqrt((s2 + median(s2)) * (1 / ncol(xa) + 1 / ncol(xb)))  # sıralama 2: düzenlenmiş t (SAM benzeri)
}
top_k <- function(sc, k) order(-abs(sc))[1:k]               # mutlak skora göre ilk k gen (sıra numarası)

rbo_lists <- function(L1, L2) rbo_value(L1, L2, K_LIST, P_RBO, "ext", "A")  # RBO_EXT (step01 fonksiyonu)

# --- 4c) Laboratuvar içi tavan C: aynı laboratuvarın ayrık tekrar yarılarından iki liste ---
disjoint_pairs <- function(n, m, ordered = FALSE) {         # {1..n}'den iki ayrık m'lik küme
  S <- combn(n, m, simplify = FALSE); out <- list()
  for (i in seq_along(S)) for (j in seq_along(S)) {
    if (i == j || length(intersect(S[[i]], S[[j]])) > 0) next  # ayrık değilse atla
    if (!ordered && j < i) next                             # sırasız ise her çifti bir kez al
    out[[length(out) + 1]] <- list(S[[i]], S[[j]])
  }
  out
}

ceiling_lab <- function(lab, g1, g2, ranking) {
  na <- ncol(lab[[g1]]); nb <- ncol(lab[[g2]])
  if (na < 2 * M_REP || nb < 2 * M_REP) return(c(C = NA, n = 0, way = NA))  # bölmek için yeterli tekrar yok
  PA <- disjoint_pairs(na, M_REP); PB <- disjoint_pairs(nb, M_REP, ordered = TRUE)
  grid <- expand.grid(a = seq_along(PA), b = seq_along(PB)) # tüm bölme kombinasyonları
  way <- "A_all"                                            # Yol A: hepsi
  if (nrow(grid) > MAX_SPLITS) { grid <- grid[sample(nrow(grid), MAX_SPLITS), ]; way <- "B_sample" }  # Yol B: rastgele
  r <- apply(grid, 1, function(z) {
    a <- PA[[z[1]]]; b <- PB[[z[2]]]
    L1 <- top_k(score_fun(lab[[g1]][, a[[1]], drop = FALSE], lab[[g2]][, b[[1]], drop = FALSE], ranking), K_LIST)
    L2 <- top_k(score_fun(lab[[g1]][, a[[2]], drop = FALSE], lab[[g2]][, b[[2]], drop = FALSE], ranking), K_LIST)
    rbo_lists(L1, L2)
  })
  c(C = mean(r), se = sd(r) / sqrt(length(r)), n = length(r), way = way)  # ortalama + Monte Carlo standart hatası
}

# --- 4d) Laboratuvarlar arası E: iki farklı laboratuvardan aynı tekrar sayısıyla listeler ---
between_labs <- function(lab1, lab2, g1, g2, ranking) {
  r <- replicate(N_BETWEEN, {
    a1 <- sample(ncol(lab1[[g1]]), M_REP); b1 <- sample(ncol(lab1[[g2]]), M_REP)  # lab1'den rastgele tekrarlar
    a2 <- sample(ncol(lab2[[g1]]), M_REP); b2 <- sample(ncol(lab2[[g2]]), M_REP)  # lab2'den rastgele tekrarlar
    L1 <- top_k(score_fun(lab1[[g1]][, a1, drop = FALSE], lab1[[g2]][, b1, drop = FALSE], ranking), K_LIST)
    L2 <- top_k(score_fun(lab2[[g1]][, a2, drop = FALSE], lab2[[g2]][, b2, drop = FALSE], ranking), K_LIST)
    rbo_lists(L1, L2)
  })
  c(E = mean(r), se = sd(r) / sqrt(length(r)))                # ortalama + Monte Carlo standart hatası
}

# --- 4e) Kalibrasyon: gerçek etki mu, gürültü sigma, laboratuvar etkisi tau (gen bazında) ---
calibrate <- function(labs, g1, g2) {
  lfc  <- sapply(labs, function(l) rowMeans(l[[g1]]) - rowMeans(l[[g2]]))   # gen x lab: laboratuvar LFC'leri
  mu   <- rowMeans(lfc)                                     # gerçek etki tahmini (laboratuvarların ortalaması)
  s2   <- sapply(labs, function(l) (rowSums((l[[g1]] - rowMeans(l[[g1]]))^2) +
                                    rowSums((l[[g2]] - rowMeans(l[[g2]]))^2)) /
                                   (ncol(l[[g1]]) + ncol(l[[g2]]) - 2))      # gen x lab: tekrar varyansı
  sigma <- sqrt(rowMeans(s2))                               # gürültü: tekrarlar arası standart sapma
  inv  <- mean(sapply(labs, function(l) 1 / ncol(l[[g1]]) + 1 / ncol(l[[g2]])))  # ortalama 1/nA + 1/nB
  tau2 <- pmax(0, apply(lfc, 1, var) - sigma^2 * inv)       # laboratuvar etkisi: LFC'nin labs arası varyansı - gürültü payı
  data.frame(gene = rownames(lfc), mu = mu, sigma = sigma, tau = sqrt(tau2))
}

# --- 4f) Çalıştır ---
if (!REDO_STEP04 && all(file.exists(c(f_cal, f_ceil, f_betw, f_par)))) {
  cat("step04 çıktıları mevcut, atlanıyor (yeniden için REDO_STEP04 <- TRUE).\n")
} else {
  t4 <- Sys.time(); set.seed(20261026)
  data_sets <- list()                                       # Yol A: step03 önbelleğinden oku
  if (file.exists(f_maqc)) data_sets$MAQC <- prep_maqc(readRDS(f_maqc))
  if (file.exists(f_seqc)) data_sets$SEQC <- prep_seqc(readRDS(f_seqc))
  if (length(data_sets) == 0) stop("step03 .rds dosyaları yok; önce step03 çalışmalı (REDO_STEP03 <- TRUE)")

  contrasts <- list("A-B" = c("A", "B"), "C-D" = c("C", "D"))  # güçlü fark (A-B) ve zayıf fark (C-D)
  rankings  <- c("LFC", "modT")                             # iki sıralama yöntemi
  cal_rows <- list(); ceil_rows <- list(); betw_rows <- list(); par_list <- list()

  for (ds in names(data_sets)) {
    labs <- data_sets[[ds]]; N_g <- nrow(labs[[1]]$A)       # laboratuvarlar ve gen sayısı
    floor_rbo <- null_moments_exact(N_g, K_LIST, rbo_weights(K_LIST, P_RBO, "ext"))$mean  # rastgele zemin (Aşama 1)
    for (cn in names(contrasts)) {
      g1 <- contrasts[[cn]][1]; g2 <- contrasts[[cn]][2]
      cat(sprintf("%s %s: kalibrasyon...\n", ds, cn))
      cp <- calibrate(labs, g1, g2); par_list[[paste(ds, cn)]] <- cp  # gen düzeyinde parametreler
      reps <- sapply(labs, function(l) min(ncol(l[[g1]]), ncol(l[[g2]])))
      cal_rows[[length(cal_rows) + 1]] <- data.frame(
        dataset = ds, contrast = cn, n_genes = N_g, n_labs = length(labs),
        reps_min = min(reps), reps_max = max(reps),
        prop_absmu_gt1 = mean(abs(cp$mu) > 1),              # |gerçek LFC| > 1 olan genlerin oranı
        absmu_q50 = median(abs(cp$mu)), absmu_q90 = quantile(abs(cp$mu), 0.90, names = FALSE),
        absmu_q99 = quantile(abs(cp$mu), 0.99, names = FALSE),
        sigma_q50 = median(cp$sigma), sigma_q90 = quantile(cp$sigma, 0.90, names = FALSE),
        tau_q50 = median(cp$tau), tau_q90 = quantile(cp$tau, 0.90, names = FALSE),
        prop_tau_pos = mean(cp$tau > 0),                    # laboratuvar etkisi > 0 görünen genlerin oranı
        floor_rbo = floor_rbo)
      for (rk in rankings) {
        cat(sprintf("   %s: tavan ve laboratuvarlar arası...\n", rk))
        Cl <- lapply(labs, ceiling_lab, g1 = g1, g2 = g2, ranking = rk)  # her laboratuvarın tavanı
        for (ln in names(labs)) ceil_rows[[length(ceil_rows) + 1]] <- data.frame(
          dataset = ds, contrast = cn, ranking = rk, lab = ln,
          C_hat = as.numeric(Cl[[ln]]["C"]), C_se = as.numeric(Cl[[ln]]["se"]), n_splits = as.numeric(Cl[[ln]]["n"]),
          split_way = Cl[[ln]]["way"], floor_rbo = floor_rbo)
        pr <- combn(names(labs), 2)                         # tüm laboratuvar çiftleri
        for (j in seq_len(ncol(pr))) {
          l1 <- pr[1, j]; l2 <- pr[2, j]
          E  <- between_labs(labs[[l1]], labs[[l2]], g1, g2, rk)
          C1 <- as.numeric(Cl[[l1]]["C"]); C2 <- as.numeric(Cl[[l2]]["C"])
          betw_rows[[length(betw_rows) + 1]] <- data.frame(
            dataset = ds, contrast = cn, ranking = rk, lab1 = l1, lab2 = l2,
            E_hat = E[["E"]], E_se = E[["se"]], C1 = C1, C2 = C2,
            rho_hat = E[["E"]] / sqrt(C1 * C2),                 # rho = 1: laboratuvar etkisi yok
            rho_reliable = min(C1, C2) >= RHO_MIN_C,            # iki tavan da yeterince yüksek mi?
            floor_rbo = floor_rbo)
        }
      }
    }
  }
  write.csv(do.call(rbind, cal_rows),  f_cal,  row.names = FALSE)   # çıktı 1
