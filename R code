# --- 9f) Fig4: tekrar korelasyon matrisleri (MAY ve COH) ---
cor_matrix <- function(rc, ds, lab, smp) {                  # uzun tablodan korelasyon matrisi
  d <- rc[rc$dataset == ds & rc$lab == lab & rc$sample == smp, ]
  reps <- sort(unique(c(d$rep_i, d$rep_j))); n <- length(reps)
  M <- matrix(NA, n, n, dimnames = list(reps, reps))        # köşegen boş (her zaman 1 olduğu için gösterilmez)
  for (k in seq_len(nrow(d))) M[as.character(d$rep_i[k]), as.character(d$rep_j[k])] <-
    M[as.character(d$rep_j[k]), as.character(d$rep_i[k])] <- d$r[k]
  M
}
heat_pal <- colorRampPalette(c("#2166AC", "#F7F7F7", "#B2182B"))(101)   # mavi (-1) - beyaz (0) - kırmızı (+1)
heat <- function(M, xlab) {                                 # hücreler tek tek çizilir, tüm çizgiler aynı kalınlıkta siyah
  n <- ncol(M); LW <- 0.9                                   # tek çizgi kalınlığı
  plot(NA, xlim = c(0.5, n + 0.5), ylim = c(0.5, n + 0.5), xaxs = "i", yaxs = "i", axes = FALSE,
       xlab = xlab, ylab = "Replicate")
  for (i in 1:n) for (j in 1:n) {                           # i = sütun (x), j = satır (yukarıdan aşağı)
    y <- n + 1 - j
    fill <- if (i == j) "grey85" else heat_pal[round((M[j, i] + 1) * 50) + 1]   # köşegen gri
    rect(i - 0.5, y - 0.5, i + 0.5, y + 0.5, col = fill, border = NA)
    if (i != j) text(i, y, sprintf("%.2f", M[j, i]), cex = 0.95, font = 2,      # KALIN sayılar
                     col = ifelse(abs(M[j, i]) > 0.6, "white", "black"))
  }
  segments(1.5:(n - 0.5), 0.5, 1.5:(n - 0.5), n + 0.5, lwd = LW)   # iç dikey çizgiler
  segments(0.5, 1.5:(n - 0.5), n + 0.5, 1.5:(n - 0.5), lwd = LW)   # iç yatay çizgiler
  rect(0.5, 0.5, n + 0.5, n + 0.5, lwd = LW, border = "black")     # dış çerçeve (aynı kalınlık)
  axis(1, at = 1:n, labels = 1:n, tick = FALSE, line = -0.4)       # çizgisiz eksen (çerçeveyle çakışmasın)
  axis(2, at = 1:n, labels = n:1, tick = FALSE, line = -0.4)
}
