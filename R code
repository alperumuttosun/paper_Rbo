# ---------------------------------------------------------------------
# step07: GENEL VE LABORATUVAR BAZINDA PERMÜTASYON TESTİ + İKİ PARTİLİ TEKRAR KONTROLÜ
#  (a) Genel test: H0 = hiçbir laboratuvar etkisi yok. İstatistik: 15 çiftin ortalama rho_hat'i.
#      Permütasyon: tüm laboratuvarların tekrarları havuzlanır, aynı sayılarla laboratuvarlara rastgele dağıtılır.
#  (b) Laboratuvar bazında: lab l için istatistik = [l'yi içeren çiftlerin ortalama rho'su] - [l'yi içermeyen çiftlerin ortalama rho'su]
#      (negatif = lab l diğerlerinden farklı). Aynı permütasyonlar kullanılır; 6 p-değerine BH düzeltmesi.
#  (c) S2b simülasyonu: bir laboratuvarın tekrarları iki partiye ayrılırsa rho_hat 1'in üstüne çıkar mı?
#  (d) Gerçek veri: laboratuvar içi tekrar kalıntılarının korelasyonu (iki parti var mı?)
# ---------------------------------------------------------------------
REDO_STEP07 <- FALSE        # TRUE: step07 yeniden hesaplanır
B_GLOBAL    <- 499          # permütasyon sayısı (en küçük p = 0.002)
SPL7        <- 30           # laboratuvar içi bölme sayısı
BTW7        <- 30           # laboratuvar başına liste havuzu (laboratuvarlar arası E için)
R_S2B       <- 150          # S2b simülasyon tekrar sayısı

f_glob <- "step07_global_tests.csv"                         # çıktı 1: genel test
f_labt <- "step07_lab_tests.csv"                            # çıktı 2: laboratuvar bazında testler
f_s2b  <- "step07_s2b_batch_sim.csv"                        # çıktı 3: iki partili tekrar simülasyonu
f_rcor <- "step07_replicate_cor.csv"                        # çıktı 4: laboratuvar içi tekrar korelasyonları

configs7 <- data.frame(dataset = c("MAQC", "MAQC", "SEQC"), contrast = c("A-B", "C-D", "A-B"),
                       ranking = c("LFC", "LFC", "LFC"))    # yalnızca LFC (modT laboratuvar etkisine duyarsız, step06)

# --- 7a) Tüm laboratuvarlar için istatistikler (listeler laboratuvar başına bir kez üretilir) ---
lab_lists <- function(lab, ranking, s0) {
  C <- mean(replicate(SPL7, {                               # laboratuvar içi tavan: ayrık 2+2 bölmeler
    ia <- sample(ncol(lab$A)); ib <- sample(ncol(lab$B))
    rbo_lists(list_sim(lab, ia[1:M_REP], ib[1:M_REP], ranking, s0),
              list_sim(lab, ia[M_REP + 1:M_REP], ib[M_REP + 1:M_REP], ranking, s0))
  }))
  pool <- replicate(BTW7, list_sim(lab, sample(ncol(lab$A), M_REP), sample(ncol(lab$B), M_REP), ranking, s0),
                    simplify = FALSE)                       # laboratuvarlar arası karşılaştırma için liste havuzu
  list(C = C, pool = pool)
}

all_stats <- function(labs, ranking, s0) {
  ll <- lapply(labs, lab_lists, ranking = ranking, s0 = s0) # her laboratuvarın tavanı ve liste havuzu
  L <- length(labs); Cv <- sapply(ll, `[[`, "C")
  R <- matrix(NA, L, L, dimnames = list(names(labs), names(labs)))
  for (i in 1:(L - 1)) for (j in (i + 1):L) {               # her çift için E ve rho
    E <- mean(mapply(rbo_lists, ll[[i]]$pool, ll[[j]]$pool))
    R[i, j] <- R[j, i] <- E / sqrt(Cv[i] * Cv[j])
  }
  glob <- mean(R[upper.tri(R)])                             # genel istatistik: ortalama rho
  labst <- sapply(1:L, function(l) {                        # laboratuvar istatistiği: kendi çiftleri - diğer çiftler
    Ro <- R[-l, -l, drop = FALSE]
    mean(R[l, -l]) - mean(Ro[upper.tri(Ro)])
  })
  list(glob = glob, lab = setNames(labst, names(labs)), C = Cv, R = R)
}

permute_labs <- function(labs) {                            # tekrarları laboratuvarlar arasında rastgele dağıt
  nA <- sapply(labs, function(l) ncol(l$A)); nB <- sapply(labs, function(l) ncol(l$B))
  PA <- do.call(cbind, lapply(labs, `[[`, "A")); PB <- do.call(cbind, lapply(labs, `[[`, "B"))
  gA <- split(sample(ncol(PA)), rep(seq_along(labs), nA)); gB <- split(sample(ncol(PB)), rep(seq_along(labs), nB))
  setNames(lapply(seq_along(labs), function(i) list(A = PA[, gA[[i]], drop = FALSE], B = PB[, gB[[i]], drop = FALSE])),
           names(labs))
}

# --- 7b) S2b: iki partili tekrarlı sahte laboratuvar ---
sim_lab_batch <- function(cp, n, beta) {
  lab <- sim_lab(cp, n)                                     # normal sahte laboratuvar
  bt <- rep(1:2, c(ceiling(n / 2), floor(n / 2)))           # tekrarları iki partiye böl (4 -> 2+2, 5 -> 3+2)
  for (b in 1:2) {                                          # her parti için A ve B'ye ayrı parti etkisi ekle
    lab$A[, bt == b] <- lab$A[, bt == b] + beta * cp$sigma * rnorm(nrow(cp))
    lab$B[, bt == b] <- lab$B[, bt == b] + beta * cp$sigma * rnorm(nrow(cp))
  }
  lab
}

# --- 7c) Laboratuvar içi tekrar kalıntılarının korelasyonu ---
rep_cor <- function(X) {                                    # X: gen x tekrar (log ölçek)
  Rz <- X - rowMeans(X)                                     # her genin laboratuvar ortalamasından sapması
  Rz <- Rz[apply(Rz, 1, sd) > 0, , drop = FALSE]
  cor(Rz)                                                   # tekrarlar arası korelasyon (eşit tekrarlarda hepsi ≈ -1/(n-1))
}

# --- 7d) Çalıştır ---
if (!REDO_STEP07 && all(file.exists(c(f_glob, f_labt, f_s2b, f_rcor)))) {
  cat("step07 çıktıları mevcut, atlanıyor (yeniden için REDO_STEP07 <- TRUE).\n")
} else {
  t7 <- Sys.time(); set.seed(20261030)
  par7 <- readRDS(f_par)
  ds7 <- list()
  if (file.exists(f_maqc)) ds7$MAQC <- prep_maqc(readRDS(f_maqc))
  if (file.exists(f_seqc)) ds7$SEQC <- prep_seqc(readRDS(f_seqc))
  ctr <- list("A-B" = c("A", "B"), "C-D" = c("C", "D"))

  # (d) tekrar korelasyonları (hızlı, önce)
  rc <- list()
  for (dn in names(ds7)) for (ln in names(ds7[[dn]])) for (g in c("A", "B")) {
    M <- rep_cor(ds7[[dn]][[ln]][[g]]); n <- ncol(M)
    for (i in 1:(n - 1)) for (j in (i + 1):n)
      rc[[length(rc) + 1]] <- data.frame(dataset = dn, lab = ln, sample = g, rep_i = colnames(M)[i],
                                         rep_j = colnames(M)[j], r = M[i, j], r_expected = -1 / (n - 1))
  }
  write.csv(do.call(rbind, rc), f_rcor, row.names = FALSE)  # çıktı 4

  # (c) S2b simülasyonu
  s2 <- list()
  for (bn in c("MAQC", "SEQC")) {
    cp <- par7[[paste(bn, "A-B")]]; if (is.null(cp)) next
    s0 <- median(cp$sigma^2); cp <- prefilter(cp, M_REP, s0); n <- n_rep_of[[bn]]
    for (beta in c(0, 0.5, 1)) {
      cat(sprintf("S2b: %s beta=%.1f\n", bn, beta))
      v <- replicate(R_S2B, rho_pair(sim_lab_batch(cp, n, beta), sim_lab(cp, n), "LFC", s0, SPL7, BTW7))
      s2[[length(s2) + 1]] <- data.frame(base = bn, beta = beta, n_rep = R_S2B,
        mean_C_batchlab = mean(v["C1", ]), mean_C_normallab = mean(v["C2", ]),
        mean_rho = mean(v["rho", ]), q025_rho = quantile(v["rho", ], 0.025, names = FALSE),
        q975_rho = quantile(v["rho", ], 0.975, names = FALSE), prop_rho_gt1 = mean(v["rho", ] > 1))
    }
  }
  write.csv(do.call(rbind, s2), f_s2b, row.names = FALSE)   # çıktı 3

  # (a) + (b) genel ve laboratuvar bazında permütasyon testleri
  gl <- list(); lt <- list()
  for (i in seq_len(nrow(configs7))) {
    cf <- configs7[i, ]; labs0 <- ds7[[cf$dataset]]; if (is.null(labs0)) next
    g1 <- ctr[[cf$contrast]][1]; g2 <- ctr[[cf$contrast]][2]
    s0 <- median(par7[[paste(cf$dataset, cf$contrast)]]$sigma^2)
    keep <- prefilter_real(labs0, g1, g2, s0)               # step06 gen filtresi (doğrulanmış)
    labs <- lapply(labs0, sub_lab, g1 = g1, g2 = g2, keep = keep)
    cat(sprintf("genel test: %s %s %s (%d permütasyon)...\n", cf$dataset, cf$contrast, cf$ranking, B_GLOBAL))
    obs <- all_stats(labs, cf$ranking, s0)                  # gözlenen istatistikler
    perm <- replicate(B_GLOBAL, { st <- all_stats(permute_labs(labs), cf$ranking, s0); c(st$glob, st$lab) })
    pg <- (1 + sum(perm[1, ] <= obs$glob)) / (B_GLOBAL + 1) # genel p (tek yönlü: etki rho'yu düşürür)
    gl[[length(gl) + 1]] <- data.frame(cf, n_labs = length(labs), T_obs = obs$glob,
      T_perm_mean = mean(perm[1, ]), T_perm_q05 = quantile(perm[1, ], 0.05, names = FALSE),
      p_global = pg, B = B_GLOBAL)
    pl <- sapply(seq_along(labs), function(l) (1 + sum(perm[1 + l, ] <= obs$lab[l])) / (B_GLOBAL + 1))
    lt[[length(lt) + 1]] <- data.frame(cf, lab = names(labs), C = obs$C,
      mean_rho_with_others = sapply(seq_along(labs), function(l) mean(obs$R[l, -l])),
      stat = obs$lab, perm_mean = rowMeans(perm[-1, , drop = FALSE]),
      p_lab = pl, p_lab_bh = p.adjust(pl, method = "BH"), row.names = NULL)
  }
  write.csv(do.call(rbind, gl), f_glob, row.names = FALSE)  # çıktı 1
  write.csv(do.call(rbind, lt), f_labt, row.names = FALSE)  # çıktı 2
  print(do.call(rbind, gl), digits = 3); print(do.call(rbind, lt), digits = 3); print(do.call(rbind, s2), digits = 3)
  cat(sprintf("step07 bitti. Süre: %.1f dakika\n", as.numeric(difftime(Sys.time(), t7, units = "mins"))))
}


# ---------------------------------------------------------------------
# step08: PARTİ TEŞHİSİ + PARTİYE DUYARLI RHO + DIŞARIDA BIRAKMA TESTLERİ
#  (a) Her laboratuvarda tekrarları en iyi ayıran iki parti bulunur (tekrar kalıntı korelasyonlarından).
#      Kural (önceden sabit): A'da ve B'de skor >= 0.5 VE A ile B'de aynı bölünme -> "ortak parti yapısı var"
#  (b) Parti yapısı olan laboratuvarda dengeli bölme: her listeye her partiden birer tekrar (parti etkisi götürülür)
#  (c) Genel test, bir (veya iki) laboratuvar dışarıda bırakılarak tekrarlanır: etki hangi laboratuvardan geliyor?
# ---------------------------------------------------------------------
REDO_STEP08 <- FALSE        # TRUE: step08 yeniden hesaplanır
BATCH_MIN   <- 0.5          # parti skoru eşiği (önceden sabit)
B_LOO       <- 199          # dışarıda bırakma testlerinde permütasyon sayısı
SPL8        <- 30           # bölme sayısı
BTW8        <- 30           # liste havuzu

f_bdiag <- "step08_batch_diag.csv"                          # çıktı 1: parti teşhisi
f_bpair <- "step08_batch_aware_pairs.csv"                   # çıktı 2: standart vs partiye duyarlı rho
f_loo   <- "step08_leave_out_tests.csv"                     # çıktı 3: dışarıda bırakma testleri

# --- 8a) En iyi iki-parti bölünmesi ---
best_partition <- function(M) {                             # M: tekrar korelasyon matrisi
  n <- ncol(M); best <- -Inf; bg <- NULL
  for (g1 in combn(n, floor(n / 2), simplify = FALSE)) {    # tüm (n/2, n - n/2) bölünmeler
    g <- rep(2, n); g[g1] <- 1
    w <- outer(g, g, "=="); diag(w) <- NA
    sc <- mean(M[which(w)]) - mean(M[which(!w)])            # parti içi ort. korelasyon - partiler arası
    if (sc > best) { best <- sc; bg <- g }
  }
  list(score = best, g = bg)
}
same_part <- function(a, b) length(a) == length(b) && (all(a == b) || all(a == 3 - b))  # etiket değişimine duyarsız

# --- 8b) Partiye duyarlı liste üretimi ---
lab_lists_batch <- function(lab, ranking, s0) {
  iA <- split(seq_len(ncol(lab$A)), lab$bA); iB <- split(seq_len(ncol(lab$B)), lab$bB)  # partilere göre tekrarlar
  pick1 <- function(v) v[sample.int(length(v), 1)]          # bir partiden rastgele bir tekrar
  half2 <- function(idx) { s <- lapply(idx, function(v) v[sample.int(length(v), 2)])    # her partiden iki farklı tekrar
                           list(sapply(s, `[`, 1), sapply(s, `[`, 2)) }                 # 1. yarı / 2. yarı
  C <- mean(replicate(SPL8, { ha <- half2(iA); hb <- half2(iB)
    rbo_lists(list_sim(lab, ha[[1]], hb[[1]], ranking, s0), list_sim(lab, ha[[2]], hb[[2]], ranking, s0)) }))
  pool <- replicate(BTW8, list_sim(lab, sapply(iA, pick1), sapply(iB, pick1), ranking, s0), simplify = FALSE)
  list(C = C, pool = pool)
}

global_p <- function(labs, ranking, s0, B) {                # genel test (step07 ile aynı istatistik)
  obs <- all_stats(labs, ranking, s0)$glob
  perm <- replicate(B, all_stats(permute_labs(labs), ranking, s0)$glob)
  c(T_obs = obs, T_perm_mean = mean(perm), p = (1 + sum(perm <= obs)) / (B + 1))
}

# --- 8c) Çalıştır ---
if (!REDO_STEP08 && all(file.exists(c(f_bdiag, f_bpair, f_loo)))) {
  cat("step08 çıktıları mevcut, atlanıyor (yeniden için REDO_STEP08 <- TRUE).\n")
} else {
  t8 <- Sys.time(); set.seed(20261031)
  par8 <- readRDS(f_par)
  ds8 <- list()
  if (file.exists(f_maqc)) ds8$MAQC <- prep_maqc(readRDS(f_maqc))
  if (file.exists(f_seqc)) ds8$SEQC <- prep_seqc(readRDS(f_seqc))
  ctr <- list("A-B" = c("A", "B"), "C-D" = c("C", "D"))

  # (a) parti teşhisi (A-B karşılaştırmasının örnekleri)
  bd <- list(); flags <- list()
  for (dn in names(ds8)) for (ln in names(ds8[[dn]])) {
    pa <- best_partition(rep_cor(ds8[[dn]][[ln]]$A)); pb <- best_partition(rep_cor(ds8[[dn]][[ln]]$B))
    fl <- pa$score >= BATCH_MIN && pb$score >= BATCH_MIN && same_part(pa$g, pb$g)
    bd[[length(bd) + 1]] <- data.frame(dataset = dn, lab = ln, score_A = pa$score, part_A = paste(pa$g, collapse = ""),
                                       score_B = pb$score, part_B = paste(pb$g, collapse = ""),
                                       same_partition = same_part(pa$g, pb$g), batch_flag = fl)
    if (fl) flags[[paste(dn, ln)]] <- list(bA = pa$g, bB = pb$g)
  }
  write.csv(do.call(rbind, bd), f_bdiag, row.names = FALSE)                  # çıktı 1

  # (b) parti yapısı olan laboratuvarların çiftleri: standart vs partiye duyarlı rho (A-B, LFC)
  bp <- list()
  for (key in names(flags)) {
    dn <- sub(" .*", "", key); ln <- sub("^[^ ]+ ", "", key); labs0 <- ds8[[dn]]
    s0 <- median(par8[[paste(dn, "A-B")]]$sigma^2); keep <- prefilter_real(labs0, "A", "B", s0)
    labs <- lapply(labs0, sub_lab, g1 = "A", g2 = "B", keep = keep)
    lf <- labs[[ln]]; lf$bA <- flags[[key]]$bA; lf$bB <- flags[[key]]$bB
    Ls <- lab_lists(lf, "LFC", s0); Lb <- lab_lists_batch(lf, "LFC", s0)       # standart ve partiye duyarlı
    for (o in setdiff(names(labs), ln)) {
      Lo <- lab_lists(labs[[o]], "LFC", s0)
      Es <- mean(mapply(rbo_lists, Ls$pool, Lo$pool)); Eb <- mean(mapply(rbo_lists, Lb$pool, Lo$pool))
      bp[[length(bp) + 1]] <- data.frame(dataset = dn, batch_lab = ln, other_lab = o, C_other = Lo$C,
        C_standard = Ls$C, E_standard = Es, rho_standard = Es / sqrt(Ls$C * Lo$C),
        C_batch_aware = Lb$C, E_batch_aware = Eb, rho_batch_aware = Eb / sqrt(Lb$C * Lo$C))
    }
  }
  write.csv(if (length(bp)) do.call(rbind, bp) else data.frame(note = "parti yapısı olan laboratuvar yok"),
            f_bpair, row.names = FALSE)                                      # çıktı 2

  # (c) dışarıda bırakma testleri (LFC)
  loo_plan <- list(list(dataset = "MAQC", contrast = "A-B", drops = c(as.list(names(ds8$MAQC)), list(c("lab1", "lab6")))),
                   list(dataset = "MAQC", contrast = "C-D", drops = c(as.list(names(ds8$MAQC)), list(c("lab1", "lab6")))),
                   list(dataset = "SEQC", contrast = "A-B", drops = list("MAY")))
  lo <- list()
  for (pl in loo_plan) {
    labs0 <- ds8[[pl$dataset]]; if (is.null(labs0)) next
    g1 <- ctr[[pl$contrast]][1]; g2 <- ctr[[pl$contrast]][2]
    s0 <- median(par8[[paste(pl$dataset, pl$contrast)]]$sigma^2); keep <- prefilter_real(labs0, g1, g2, s0)
    labs <- lapply(labs0, sub_lab, g1 = g1, g2 = g2, keep = keep)
    for (dr in pl$drops) {
      dr <- intersect(dr, names(labs)); if (!length(dr)) next
      cat(sprintf("dışarıda bırakma: %s %s - %s ...\n", pl$dataset, pl$contrast, paste(dr, collapse = "+")))
      v <- global_p(labs[setdiff(names(labs), dr)], "LFC", s0, B_LOO)
      lo[[length(lo) + 1]] <- data.frame(dataset = pl$dataset, contrast = pl$contrast, ranking = "LFC",
        left_out = paste(dr, collapse = "+"), n_labs = length(labs) - length(dr),
        T_obs = v[["T_obs"]], T_perm_mean = v[["T_perm_mean"]], p_global = v[["p"]], B = B_LOO)
    }
  }
  write.csv(do.call(rbind, lo), f_loo, row.names = FALSE)                    # çıktı 3
  print(do.call(rbind, bd), digits = 3); if (length(bp)) print(do.call(rbind, bp), digits = 3); print(do.call(rbind, lo), digits = 3)
  cat(sprintf("step08 bitti. Süre: %.1f dakika\n", as.numeric(difftime(Sys.time(), t8, units = "mins"))))
}


