prep_maqc <- function(m) {
  ph <- m$pheno; ok <- !is.na(ph$site) & ph$samp %in% c("A", "B", "C", "D")
  ph <- ph[ok, ]; X <- m$expr[, match(ph$sample_id, colnames(m$expr)), drop = FALSE]
  X <- matrix(as.numeric(X), nrow(X), dimnames = dimnames(X))
  if (median(X, na.rm = TRUE) > 20) X <- log2(pmax(X, 1))
  X <- X[rowSums(is.na(X)) == 0, , drop = FALSE]
  am <- rowMeans(X); X <- X[am > quantile(am, 0.25), , drop = FALSE]
  labs <- lapply(sort(unique(ph$site)), function(s)
    setNames(lapply(c("A", "B", "C", "D"), function(g) X[, ph$site == s & ph$samp == g, drop = FALSE]),
             c("A", "B", "C", "D")))
  names(labs) <- paste0("lab", sort(unique(ph$site)))
  labs
}

prep_seqc <- function(s) {
  cnt <- list(); key <- NULL
  for (site in names(s$ilm)) {
    tb <- s$ilm[[site]]
    if ("IsERCC" %in% names(tb)) tb <- tb[!as.logical(tb$IsERCC), ]
    pc <- parse_lib_cols(colnames(tb)); pc <- pc[pc$samp %in% c("A", "B", "C", "D"), ]
    if (DROP_VENDOR) pc <- pc[pc$repl != "5", ]
    M  <- as.matrix(tb[, pc$col]); storage.mode(M) <- "double"
    lib <- paste(pc$samp, pc$repl, sep = "_")
    Cm <- t(rowsum(t(M), lib))
    rownames(Cm) <- paste(tb$EntrezID, tb$Symbol)
    Cm <- Cm[!duplicated(rownames(Cm)), , drop = FALSE]
    cnt[[site]] <- Cm
    key <- if (is.null(key)) rownames(Cm) else intersect(key, rownames(Cm))
  }
  all <- do.call(cbind, lapply(cnt, function(Cm) Cm[key, , drop = FALSE]))
  cpm <- t(t(all) / colSums(all)) * 1e6
  keep <- rowMeans(cpm) >= 1
  labs <- lapply(names(cnt), function(site) {
    Cm <- cnt[[site]][key[keep], , drop = FALSE]
    L  <- log2((Cm + 2) / (colSums(cnt[[site]][key, ]) + 4) * 1e6)
    smp <- sub("_.*", "", colnames(L))
    setNames(lapply(c("A", "B", "C", "D"), function(g) L[, smp == g, drop = FALSE]), c("A", "B", "C", "D"))
  })
  names(labs) <- names(cnt)
  labs
}

score_fun <- function(xa, xb, ranking) {
  d <- rowMeans(xa) - rowMeans(xb)
  if (ranking == "LFC") return(d)
  s2 <- (rowSums((xa - rowMeans(xa))^2) + rowSums((xb - rowMeans(xb))^2)) /
        (ncol(xa) + ncol(xb) - 2)
  d / sqrt((s2 + median(s2)) * (1 / ncol(xa) + 1 / ncol(xb)))
}
top_k <- function(sc, k) order(-abs(sc))[1:k]

rbo_lists <- function(L1, L2) rbo_value(L1, L2, K_LIST, P_RBO, "ext", "A")

disjoint_pairs <- function(n, m, ordered = FALSE) {
  S <- combn(n, m, simplify = FALSE); out <- list()
  for (i in seq_along(S)) for (j in seq_along(S)) {
    if (i == j || length(intersect(S[[i]], S[[j]])) > 0) next
    if (!ordered && j < i) next
    out[[length(out) + 1]] <- list(S[[i]], S[[j]])
  }
  out
}

ceiling_lab <- function(lab, g1, g2, ranking) {
  na <- ncol(lab[[g1]]); nb <- ncol(lab[[g2]])
  if (na < 2 * M_REP || nb < 2 * M_REP) return(c(C = NA, n = 0, way = NA))
  PA <- disjoint_pairs(na, M_REP); PB <- disjoint_pairs(nb, M_REP, ordered = TRUE)
  grid <- expand.grid(a = seq_along(PA), b = seq_along(PB))
  way <- "A_all"
  if (nrow(grid) > MAX_SPLITS) { grid <- grid[sample(nrow(grid), MAX_SPLITS), ]; way <- "B_sample" }
  r <- apply(grid, 1, function(z) {
    a <- PA[[z[1]]]; b <- PB[[z[2]]]
    L1 <- top_k(score_fun(lab[[g1]][, a[[1]], drop = FALSE], lab[[g2]][, b[[1]], drop = FALSE], ranking), K_LIST)
    L2 <- top_k(score_fun(lab[[g1]][, a[[2]], drop = FALSE], lab[[g2]][, b[[2]], drop = FALSE], ranking), K_LIST)
    rbo_lists(L1, L2)
  })
  c(C = mean(r), se = sd(r) / sqrt(length(r)), n = length(r), way = way)
}

between_labs <- function(lab1, lab2, g1, g2, ranking) {
  r <- replicate(N_BETWEEN, {
    a1 <- sample(ncol(lab1[[g1]]), M_REP); b1 <- sample(ncol(lab1[[g2]]), M_REP)
    a2 <- sample(ncol(lab2[[g1]]), M_REP); b2 <- sample(ncol(lab2[[g2]]), M_REP)
    L1 <- top_k(score_fun(lab1[[g1]][, a1, drop = FALSE], lab1[[g2]][, b1, drop = FALSE], ranking), K_LIST)
    L2 <- top_k(score_fun(lab2[[g1]][, a2, drop = FALSE], lab2[[g2]][, b2, drop = FALSE], ranking), K_LIST)
    rbo_lists(L1, L2)
  })
  c(E = mean(r), se = sd(r) / sqrt(length(r)))
}

calibrate <- function(labs, g1, g2) {
  lfc  <- sapply(labs, function(l) rowMeans(l[[g1]]) - rowMeans(l[[g2]]))
  mu   <- rowMeans(lfc)
  s2   <- sapply(labs, function(l) (rowSums((l[[g1]] - rowMeans(l[[g1]]))^2) +
                                    rowSums((l[[g2]] - rowMeans(l[[g2]]))^2)) /
                                   (ncol(l[[g1]]) + ncol(l[[g2]]) - 2))
  sigma <- sqrt(rowMeans(s2))
  inv  <- mean(sapply(labs, function(l) 1 / ncol(l[[g1]]) + 1 / ncol(l[[g2]])))
  tau2 <- pmax(0, apply(lfc, 1, var) - sigma^2 * inv)
  data.frame(gene = rownames(lfc), mu = mu, sigma = sigma, tau = sqrt(tau2))
}

if (!REDO_STEP04 && all(file.exists(c(f_cal, f_ceil, f_betw, f_par)))) {
  cat("step04 outputs exist, skipping (set REDO_STEP04 <- TRUE to rerun).\n")
} else {
  t4 <- Sys.time(); set.seed(20261026)
  data_sets <- list()
  if (file.exists(f_maqc)) data_sets$MAQC <- prep_maqc(readRDS(f_maqc))
  if (file.exists(f_seqc)) data_sets$SEQC <- prep_seqc(readRDS(f_seqc))
  if (length(data_sets) == 0) stop("step03 .rds files not found; run step03 first (REDO_STEP03 <- TRUE)")

  contrasts <- list("A-B" = c("A", "B"), "C-D" = c("C", "D"))
  rankings  <- c("LFC", "modT")
  cal_rows <- list(); ceil_rows <- list(); betw_rows <- list(); par_list <- list()

  for (ds in names(data_sets)) {
    labs <- data_sets[[ds]]; N_g <- nrow(labs[[1]]$A)
    floor_rbo <- null_moments_exact(N_g, K_LIST, rbo_weights(K_LIST, P_RBO, "ext"))$mean
    for (cn in names(contrasts)) {
      g1 <- contrasts[[cn]][1]; g2 <- contrasts[[cn]][2]
      cat(sprintf("%s %s: calibration...\n", ds, cn))
      cp <- calibrate(labs, g1, g2); par_list[[paste(ds, cn)]] <- cp
      reps <- sapply(labs, function(l) min(ncol(l[[g1]]), ncol(l[[g2]])))
      cal_rows[[length(cal_rows) + 1]] <- data.frame(
        dataset = ds, contrast = cn, n_genes = N_g, n_labs = length(labs),
        reps_min = min(reps), reps_max = max(reps),
        prop_absmu_gt1 = mean(abs(cp$mu) > 1),
        absmu_q50 = median(abs(cp$mu)), absmu_q90 = quantile(abs(cp$mu), 0.90, names = FALSE),
        absmu_q99 = quantile(abs(cp$mu), 0.99, names = FALSE),
        sigma_q50 = median(cp$sigma), sigma_q90 = quantile(cp$sigma, 0.90, names = FALSE),
        tau_q50 = median(cp$tau), tau_q90 = quantile(cp$tau, 0.90, names = FALSE),
        prop_tau_pos = mean(cp$tau > 0),
        floor_rbo = floor_rbo)
      for (rk in rankings) {
        cat(sprintf("   %s: ceilings and between-laboratory agreement...\n", rk))
        Cl <- lapply(labs, ceiling_lab, g1 = g1, g2 = g2, ranking = rk)
        for (ln in names(labs)) ceil_rows[[length(ceil_rows) + 1]] <- data.frame(
          dataset = ds, contrast = cn, ranking = rk, lab = ln,
          C_hat = as.numeric(Cl[[ln]]["C"]), C_se = as.numeric(Cl[[ln]]["se"]), n_splits = as.numeric(Cl[[ln]]["n"]),
          split_way = Cl[[ln]]["way"], floor_rbo = floor_rbo)
        pr <- combn(names(labs), 2)
        for (j in seq_len(ncol(pr))) {
          l1 <- pr[1, j]; l2 <- pr[2, j]
          E  <- between_labs(labs[[l1]], labs[[l2]], g1, g2, rk)
          C1 <- as.numeric(Cl[[l1]]["C"]); C2 <- as.numeric(Cl[[l2]]["C"])
          betw_rows[[length(betw_rows) + 1]] <- data.frame(
            dataset = ds, contrast = cn, ranking = rk, lab1 = l1, lab2 = l2,
            E_hat = E[["E"]], E_se = E[["se"]], C1 = C1, C2 = C2,
            rho_hat = E[["E"]] / sqrt(C1 * C2),
            rho_reliable = min(C1, C2) >= RHO_MIN_C,
            floor_rbo = floor_rbo)
        }
      }
    }
  }
  write.csv(do.call(rbind, cal_rows),  f_cal,  row.names = FALSE)
  write.csv(do.call(rbind, ceil_rows), f_ceil, row.names = FALSE)
  write.csv(do.call(rbind, betw_rows), f_betw, row.names = FALSE)
  saveRDS(par_list, f_par)
  cat(sprintf("step04 done. Time: %.1f min\n", as.numeric(difftime(Sys.time(), t4, units = "mins"))))
}

# ---- step05: calibrated simulation ----
REDO_STEP05 <- FALSE  # TRUE recomputes the step
R_SIM       <- 200  # synthetic laboratory pairs per scenario
SIM_SPLITS  <- 30  # splits per synthetic laboratory
SIM_BETWEEN <- 30  # between-laboratory draws
G_KEEP      <- 3000  # genes kept for speed
RUN_S5      <- TRUE  # pairwise permutation test simulation (slow)
R_PERM_SIM  <- 60  # synthetic pairs for the permutation test
B_PERM      <- 49  # permutations per test

f_sum  <- "step05_sim_summary.csv"
f_raw  <- "step05_sim_raw.csv"
f_perm <- "step05_perm_test.csv"

get_bases <- function() {
  if (file.exists(f_par)) {
    par <- readRDS(f_par)
    out <- list(MAQC = par[["MAQC A-B"]], SEQC = par[["SEQC A-B"]])
    out <- out[!sapply(out, is.null)]
    if (length(out) > 0) return(list(bases = out, source = "step04 calibration (real data)"))
  }
  set.seed(1); G <- 20000
  mu <- rbinom(G, 1, 0.3) * rnorm(G, 0, 2)
  list(bases = list(GENERIC = data.frame(gene = paste0("g", 1:G), mu = mu,
                                         sigma = 0.15, tau = 0.1)),
       source = "generic default parameters (step04 calibration not found)")
}

prefilter <- function(cp, m, s0) {
  sd_d <- cp$sigma * sqrt(2 / m)
  opt_lfc <- abs(cp$mu) + 3 * sd_d
  opt_t   <- opt_lfc / sqrt((cp$sigma^2 + s0) * (2 / m))
  keep <- union(order(-opt_lfc)[1:min(G_KEEP, nrow(cp))], order(-opt_t)[1:min(G_KEEP, nrow(cp))])
  cp[keep, ]
}

sim_lab <- function(cp, n, b_sd = 0, noise = 1, outlier = 0) {
  G <- nrow(cp)
  b <- rnorm(G, 0, b_sd)
  A <- (cp$mu + b) / 2 + noise * cp$sigma * matrix(rnorm(G * n), G)
  B <- -(cp$mu + b) / 2 + noise * cp$sigma * matrix(rnorm(G * n), G)
  if (outlier > 0) A[, 1] <- A[, 1] + outlier * cp$sigma * rnorm(G)
  list(A = A, B = B)
}

score_sim <- function(xa, xb, ranking, s0) {
  d <- rowMeans(xa) - rowMeans(xb)
  if (ranking == "LFC") return(d)
  s2 <- (rowSums((xa - rowMeans(xa))^2) + rowSums((xb - rowMeans(xb))^2)) / (ncol(xa) + ncol(xb) - 2)
  d / sqrt((s2 + s0) * (1 / ncol(xa) + 1 / ncol(xb)))
}
list_sim <- function(lab, ia, ib, ranking, s0)
  top_k(score_sim(lab$A[, ia, drop = FALSE], lab$B[, ib, drop = FALSE], ranking, s0), K_LIST)

rho_pair <- function(l1, l2, ranking, s0, n_spl = SIM_SPLITS, n_btw = SIM_BETWEEN) {
  ceil1 <- function(lab) mean(replicate(n_spl, {
    ia <- sample(ncol(lab$A)); ib <- sample(ncol(lab$B))
    rbo_lists(list_sim(lab, ia[1:M_REP], ib[1:M_REP], ranking, s0),
              list_sim(lab, ia[M_REP + 1:M_REP], ib[M_REP + 1:M_REP], ranking, s0))
  }))
  C1 <- ceil1(l1); C2 <- ceil1(l2)
  E <- mean(replicate(n_btw,
    rbo_lists(list_sim(l1, sample(ncol(l1$A), M_REP), sample(ncol(l1$B), M_REP), ranking, s0),
              list_sim(l2, sample(ncol(l2$A), M_REP), sample(ncol(l2$B), M_REP), ranking, s0))))
  c(C1 = C1, C2 = C2, E = E, rho = E / sqrt(C1 * C2))
}

perm_test <- function(l1, l2, ranking, s0) {
  obs <- rho_pair(l1, l2, ranking, s0, 20, 20)[["rho"]]
  n1 <- ncol(l1$A); pA <- cbind(l1$A, l2$A); pB <- cbind(l1$B, l2$B)
  perm <- replicate(B_PERM, {
    ia <- sample(ncol(pA)); ib <- sample(ncol(pB))
    rho_pair(list(A = pA[, ia[1:n1], drop = FALSE], B = pB[, ib[1:n1], drop = FALSE]),
             list(A = pA[, ia[-(1:n1)], drop = FALSE], B = pB[, ib[-(1:n1)], drop = FALSE]),
             ranking, s0, 20, 20)[["rho"]]
  })
  (1 + sum(perm <= obs)) / (B_PERM + 1)
}

scen <- rbind(
  data.frame(scenario = "S0",  level = "none",       kappa = 0,    use_tau = FALSE, outlier = 0, noise2 = 1,   mu_scale = 1,    rk = "LFC,modT"),
  data.frame(scenario = "S1",  level = "kappa=0.25", kappa = 0.25, use_tau = FALSE, outlier = 0, noise2 = 1,   mu_scale = 1,    rk = "LFC"),
  data.frame(scenario = "S1",  level = "kappa=0.5",  kappa = 0.5,  use_tau = FALSE, outlier = 0, noise2 = 1,   mu_scale = 1,    rk = "LFC"),
  data.frame(scenario = "S1",  level = "kappa=1",    kappa = 1,    use_tau = FALSE, outlier = 0, noise2 = 1,   mu_scale = 1,    rk = "LFC"),
  data.frame(scenario = "S1c", level = "tau_g",      kappa = NA,   use_tau = TRUE,  outlier = 0, noise2 = 1,   mu_scale = 1,    rk = "LFC"),
  data.frame(scenario = "S2",  level = "outlier=2",  kappa = 0,    use_tau = FALSE, outlier = 2, noise2 = 1,   mu_scale = 1,    rk = "LFC,modT"),
  data.frame(scenario = "S3",  level = "noise2=1.5", kappa = 0,    use_tau = FALSE, outlier = 0, noise2 = 1.5, mu_scale = 1,    rk = "LFC"),
  data.frame(scenario = "S4",  level = "mu x0.5",    kappa = 0,    use_tau = FALSE, outlier = 0, noise2 = 1,   mu_scale = 0.5,  rk = "LFC"),
  data.frame(scenario = "S4",  level = "mu x0.25",   kappa = 0,    use_tau = FALSE, outlier = 0, noise2 = 1,   mu_scale = 0.25, rk = "LFC"),
  data.frame(scenario = "S4",  level = "mu x0.1",    kappa = 0,    use_tau = FALSE, outlier = 0, noise2 = 1,   mu_scale = 0.1,  rk = "LFC"))
n_rep_of <- c(MAQC = 5, SEQC = 4, GENERIC = 4)

if (!REDO_STEP05 && all(file.exists(c(f_sum, f_raw)))) {
  cat("step05 outputs exist, skipping (set REDO_STEP05 <- TRUE to rerun).\n")
} else {
  t5 <- Sys.time(); set.seed(20261027)
  gb <- get_bases(); cat("step05 parameter source:", gb$source, "\n")
  raw <- list()
  for (bn in names(gb$bases)) {
    cp0 <- gb$bases[[bn]]; s0 <- median(cp0$sigma^2)
    cp0 <- prefilter(cp0, M_REP, s0)
    n <- n_rep_of[[bn]]
    for (i in seq_len(nrow(scen))) {
      sc <- scen[i, ]; rks <- strsplit(sc$rk, ",")[[1]]
      cat(sprintf("%s %s %s ...\n", bn, sc$scenario, sc$level))
      cp <- cp0; cp$mu <- cp$mu * sc$mu_scale
      bsd <- if (sc$use_tau) cp$tau else sc$kappa * cp$sigma
      for (r in seq_len(R_SIM)) {
        l1 <- sim_lab(cp, n, bsd, 1, sc$outlier)
        l2 <- sim_lab(cp, n, bsd, sc$noise2, 0)
        for (rk in rks) {
          v <- rho_pair(l1, l2, rk, s0)
          raw[[length(raw) + 1]] <- data.frame(base = bn, scenario = sc$scenario, level = sc$level,
                                               ranking = rk, rep = r, C1 = v[["C1"]], C2 = v[["C2"]],
                                               E = v[["E"]], rho = v[["rho"]])
        }
      }
    }
  }
  raw <- do.call(rbind, raw)
  raw$param_source <- gb$source
  write.csv(raw, f_raw, row.names = FALSE)

  q <- function(x, p) quantile(x, p, names = FALSE, na.rm = TRUE)
  key <- unique(raw[, c("base", "scenario", "level", "ranking")])
  smry <- do.call(rbind, lapply(seq_len(nrow(key)), function(j) {
    d <- merge(raw, key[j, ])
    data.frame(key[j, ], n_rep = nrow(d), mean_C = mean(c(d$C1, d$C2)), mean_E = mean(d$E),
               mean_rho = mean(d$rho), sd_rho = sd(d$rho), q025_rho = q(d$rho, 0.025),
               q975_rho = q(d$rho, 0.975), prop_rho_gt1 = mean(d$rho > 1),
               param_source = gb$source)
  }))
  write.csv(smry, f_sum, row.names = FALSE)
  print(smry[, c("base", "scenario", "level", "ranking", "mean_C", "mean_rho", "sd_rho", "prop_rho_gt1")], digits = 3)

  if (RUN_S5) {
    prow <- list()
    for (bn in names(gb$bases)) {
      cp <- gb$bases[[bn]]; s0 <- median(cp$sigma^2); cp <- prefilter(cp, M_REP, s0); n <- n_rep_of[[bn]]
      for (kap in c(0, 0.5)) {
        cat(sprintf("S5 permutation test: %s kappa=%.1f ...\n", bn, kap))
        pv <- replicate(R_PERM_SIM, {
          l1 <- sim_lab(cp, n, kap * cp$sigma); l2 <- sim_lab(cp, n, kap * cp$sigma)
          perm_test(l1, l2, "LFC", s0)
        })
        prow[[length(prow) + 1]] <- data.frame(base = bn, kappa = kap, n_rep = R_PERM_SIM, B_perm = B_PERM,
                                               reject_05 = mean(pv <= 0.05), reject_10 = mean(pv <= 0.10),
                                               param_source = gb$source)
      }
    }
    write.csv(do.call(rbind, prow), f_perm, row.names = FALSE)
    print(do.call(rbind, prow))
  }
  cat(sprintf("step05 done. Time: %.1f min\n", as.numeric(difftime(Sys.time(), t5, units = "mins"))))
}

