    if (!has_idr) has_idr <- tryCatch({ install.packages("idr", repos = "https://cloud.r-project.org")
                                        requireNamespace("idr", quietly = TRUE) }, error = function(e) FALSE)
    has_marr <- requireNamespace("marr", quietly = TRUE)     # Yol B: Bioconductor marr
