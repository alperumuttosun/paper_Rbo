  cat(sprintf("step04 bitti. Süre: %.1f dakika\n", as.numeric(difftime(Sys.time(), t4, units = "mins"))))
}


# ---------------------------------------------------------------------
# step05: SİMÜLASYON (sahte laboratuvarlar, gerçek veriden kalibre edilmiş)
#  Her sahte laboratuvar: gen g için A tekrarları = (mu_g + b_g)/2 + gürültü, B tekrarları = -(mu_g + b_g)/2 + gürültü
#  mu_g, sigma_g, tau_g = step04'te MAQC ve SEQC'den ölçülen değerler
#  Senaryolar:
#   S0  laboratuvar etkisi yok (b = 0)                     -> rho_hat 1 civarında mı? ne kadar dağılıyor?
#   S1  laboratuvar etkisi b ~ N(0, (kappa*sigma_g)^2)      -> rho ne kadar düşüyor? (kappa = 0.25, 0.5, 1)
#   S1c laboratuvar etkisi b ~ N(0, tau_g^2) (gerçek tau)   -> gerçekçi laboratuvar etkisi
#   S2  1. laboratuvarda tek aykırı tekrar                  -> rho_hat > 1'in nedeni bu mu?
#   S3  2. laboratuvar 1.5 kat daha gürültülü, sapma yok    -> gürültü farkı tek başına rho'yu düşürür mü?
#   S4  sinyal zayıflatılır (mu x 0.5, 0.25, 0.1)           -> tavan küçülünce rho_hat ne kadar güvenilmez?
#   S5  permütasyon testi (S0 = yanlış alarm, S1 kappa=0.5 = güç)
# ---------------------------------------------------------------------
REDO_STEP05 <- FALSE        # TRUE: step05 yeniden hesaplanır
R_SIM       <- 200          # her senaryoda sahte laboratuvar çifti sayısı
SIM_SPLITS  <- 30           # sahte laboratuvarda tavan için rastgele bölme sayısı
SIM_BETWEEN <- 30           # sahte laboratuvarlar arası çekiliş sayısı
G_KEEP      <- 3000         # hız için: ilk-100'e girme şansı olan en olası 3000 (+3000) gen tutulur
RUN_S5      <- TRUE         # permütasyon testi simülasyonu (en uzun kısım)
R_PERM_SIM  <- 60           # permütasyon testi için sahte çift sayısı
B_PERM      <- 49           # her testte permütasyon sayısı

f_sum  <- "step05_sim_summary.csv"                          # çıktı 1: senaryo özetleri
f_raw  <- "step05_sim_raw.csv"                              # çıktı 2: tüm tekrarlar (grafikler için)
f_perm <- "step05_perm_test.csv"                            # çıktı 3: permütasyon testi yanlış alarm ve güç

# --- 5a) Parametreler: Yol A = step04 kalibrasyonu (gerçek veri), Yol B = genel varsayılan parametreler ---
get_bases <- function() {
  if (file.exists(f_par)) {                                 # Yol A
    par <- readRDS(f_par)
    out <- list(MAQC = par[["MAQC A-B"]], SEQC = par[["SEQC A-B"]])
    out <- out[!sapply(out, is.null)]
    if (length(out) > 0) return(list(bases = out, source = "step04 calibration (real data)"))
  }
  set.seed(1); G <- 20000                                   # Yol B: kalibrasyon yoksa genel parametreler
  mu <- rbinom(G, 1, 0.3) * rnorm(G, 0, 2)                  # genlerin %30'u değişiyor
  list(bases = list(GENERIC = data.frame(gene = paste0("g", 1:G), mu = mu,
                                         sigma = 0.15, tau = 0.1)),
       source = "generic default parameters (step04 calibration not found)")
}

prefilter <- function(cp, m, s0) {                          # ilk-100'e girme şansı olmayan genleri at
  sd_d <- cp$sigma * sqrt(2 / m)                            # m tekrarla LFC'nin standart sapması
  opt_lfc <- abs(cp$mu) + 3 * sd_d                          # iyimser LFC skoru
  opt_t   <- opt_lfc / sqrt((cp$sigma^2 + s0) * (2 / m))    # iyimser düzenlenmiş t skoru
  keep <- union(order(-opt_lfc)[1:min(G_KEEP, nrow(cp))], order(-opt_t)[1:min(G_KEEP, nrow(cp))])
  cp[keep, ]
}

# --- 5b) Sahte laboratuvar üret ---
sim_lab <- function(cp, n, b_sd = 0, noise = 1, outlier = 0) {
  G <- nrow(cp)
  b <- rnorm(G, 0, b_sd)                                    # laboratuvar etkisi (gen bazında)
  A <- (cp$mu + b) / 2 + noise * cp$sigma * matrix(rnorm(G * n), G)   # A örneği tekrarları
  B <- -(cp$mu + b) / 2 + noise * cp$sigma * matrix(rnorm(G * n), G)  # B örneği tekrarları
  if (outlier > 0) A[, 1] <- A[, 1] + outlier * cp$sigma * rnorm(G)   # 1. A tekrarına ek sapma (aykırı tekrar)
  list(A = A, B = B)
}

# --- 5c) Skor (step04 ile aynı, düzenlenmiş t'de sabit s0) ---
score_sim <- function(xa, xb, ranking, s0) {
  d <- rowMeans(xa) - rowMeans(xb)                          # LFC
  if (ranking == "LFC") return(d)
  s2 <- (rowSums((xa - rowMeans(xa))^2) + rowSums((xb - rowMeans(xb))^2)) / (ncol(xa) + ncol(xb) - 2)
  d / sqrt((s2 + s0) * (1 / ncol(xa) + 1 / ncol(xb)))       # düzenlenmiş t
}
list_sim <- function(lab, ia, ib, ranking, s0)              # seçilen tekrarlarla ilk-k listesi
  top_k(score_sim(lab$A[, ia, drop = FALSE], lab$B[, ib, drop = FALSE], ranking, s0), K_LIST)

# --- 5d) Bir laboratuvar çifti için C1, C2, E, rho ---
rho_pair <- function(l1, l2, ranking, s0, n_spl = SIM_SPLITS, n_btw = SIM_BETWEEN) {
  ceil1 <- function(lab) mean(replicate(n_spl, {            # laboratuvar içi: rastgele ayrık 2+2 bölme
    ia <- sample(ncol(lab$A)); ib <- sample(ncol(lab$B))
    rbo_lists(list_sim(lab, ia[1:M_REP], ib[1:M_REP], ranking, s0),
              list_sim(lab, ia[M_REP + 1:M_REP], ib[M_REP + 1:M_REP], ranking, s0))
  }))
  C1 <- ceil1(l1); C2 <- ceil1(l2)
  E <- mean(replicate(n_btw,                                # laboratuvarlar arası: rastgele 2'şer tekrar
    rbo_lists(list_sim(l1, sample(ncol(l1$A), M_REP), sample(ncol(l1$B), M_REP), ranking, s0),
              list_sim(l2, sample(ncol(l2$A), M_REP), sample(ncol(l2$B), M_REP), ranking, s0))))
  c(C1 = C1, C2 = C2, E = E, rho = E / sqrt(C1 * C2))
}

# --- 5e) Permütasyon testi: H0 = tekrarlar laboratuvarlar arasında değiştirilebilir (laboratuvar etkisi yok) ---
perm_test <- function(l1, l2, ranking, s0) {
  obs <- rho_pair(l1, l2, ranking, s0, 20, 20)[["rho"]]     # gözlenen rho (daha az bölme ile, hız için)
  n1 <- ncol(l1$A); pA <- cbind(l1$A, l2$A); pB <- cbind(l1$B, l2$B)  # tekrarları havuzla
  perm <- replicate(B_PERM, {
    ia <- sample(ncol(pA)); ib <- sample(ncol(pB))          # tekrarları rastgele iki sahte laboratuvara dağıt
    rho_pair(list(A = pA[, ia[1:n1], drop = FALSE], B = pB[, ib[1:n1], drop = FALSE]),
             list(A = pA[, ia[-(1:n1)], drop = FALSE], B = pB[, ib[-(1:n1)], drop = FALSE]),
             ranking, s0, 20, 20)[["rho"]]
  })
  (1 + sum(perm <= obs)) / (B_PERM + 1)                     # tek yönlü p: laboratuvar etkisi rho'yu düşürür
}

# --- 5f) Senaryo tablosu ---
scen <- rbind(
  data.frame(scenario = "S0",  level = "none",       kappa = 0,    use_tau = FALSE, outlier = 0, noise2 = 1,   mu_scale = 1,    rk = "LFC,modT"),
  data.frame(scenario = "S1",  level = "kappa=0.25", kappa = 0.25, use_tau = FALSE, outlier = 0, noise2 = 1,   mu_scale = 1,    rk = "LFC"),
  data.frame(scenario = "S1",  level = "kappa=0.5",  kappa = 0.5,  use_tau = FALSE, outlier = 0, noise2 = 1,   mu_scale = 1,    rk = "LFC"),
  data.frame(scenario = "S1",  level = "kappa=1",    kappa = 1,    use_tau = FALSE, outlier = 0, noise2 = 1,   mu_scale = 1,    rk = "LFC"),
  data.frame(scenario = "S1c", level = "tau_g",      kappa = NA,   use_tau = TRUE,  outlier = 0, noise2 = 1,   mu_scale = 1,    rk = "LFC"),
  data.frame(scenario = "S2",  level = "outlier=2",  kappa = 0,    use_tau = FALSE, outlier = 2, noise2 = 1,   mu_scale = 1,    rk = "LFC,modT"),
  data.frame(scenario = "S3",  level = "noise2=1.5", kappa = 0,    use_tau = FALSE, outlier = 0, noise2 = 1.5, mu_scale = 1,    rk = "LFC"),
  data.frame(scenario = "S4",  level = "mu x0.5",    kappa = 0,    use_tau = FALSE, outlier = 0, noise2 = 1,   mu_scale = 0.5,  rk = "LFC"),
  data.frame(scenario = "S4",  level = "mu x0.25",   kappa = 0,    use_tau = FALSE, outlier = 0, noise2 = 1,   mu_scale = 0.25, rk = "LFC"),
  data.frame(scenario = "S4",  level = "mu x0.1",    kappa = 0,    use_tau = FALSE, outlier = 0, noise2 = 1,   mu_scale = 0.1,  rk = "LFC"))
n_rep_of <- c(MAQC = 5, SEQC = 4, GENERIC = 4)              # gerçek veri tasarımındaki tekrar sayısı

# --- 5g) Çalıştır ---
if (!REDO_STEP05 && all(file.exists(c(f_sum, f_raw)))) {
  cat("step05 çıktıları mevcut, atlanıyor (yeniden için REDO_STEP05 <- TRUE).\n")
} else {
  t5 <- Sys.time(); set.seed(20261027)
  gb <- get_bases(); cat("step05 parametre kaynağı:", gb$source, "\n")
  raw <- list()
  for (bn in names(gb$bases)) {
    cp0 <- gb$bases[[bn]]; s0 <- median(cp0$sigma^2)        # düzenlenmiş t için sabit (tüm genlerden)
    cp0 <- prefilter(cp0, M_REP, s0)                        # hız için gen filtresi
    n <- n_rep_of[[bn]]
    for (i in seq_len(nrow(scen))) {
      sc <- scen[i, ]; rks <- strsplit(sc$rk, ",")[[1]]
      cat(sprintf("%s %s %s ...\n", bn, sc$scenario, sc$level))
      cp <- cp0; cp$mu <- cp$mu * sc$mu_scale               # S4: sinyali zayıflat
      bsd <- if (sc$use_tau) cp$tau else sc$kappa * cp$sigma  # laboratuvar etkisinin standart sapması
      for (r in seq_len(R_SIM)) {
        l1 <- sim_lab(cp, n, bsd, 1, sc$outlier)            # sahte laboratuvar 1
        l2 <- sim_lab(cp, n, bsd, sc$noise2, 0)             # sahte laboratuvar 2
        for (rk in rks) {
          v <- rho_pair(l1, l2, rk, s0)
          raw[[length(raw) + 1]] <- data.frame(base = bn, scenario = sc$scenario, level = sc$level,
                                               ranking = rk, rep = r, C1 = v[["C1"]], C2 = v[["C2"]],
                                               E = v[["E"]], rho = v[["rho"]])
        }
      }
    }
  }
  raw <- do.call(rbind, raw)
  raw$param_source <- gb$source
  write.csv(raw, f_raw, row.names = FALSE)                  # çıktı 2

  q <- function(x, p) quantile(x, p, names = FALSE, na.rm = TRUE)
  key <- unique(raw[, c("base", "scenario", "level", "ranking")])
  smry <- do.call(rbind, lapply(seq_len(nrow(key)), function(j) {
    d <- merge(raw, key[j, ])
    data.frame(key[j, ], n_rep = nrow(d), mean_C = mean(c(d$C1, d$C2)), mean_E = mean(d$E),
               mean_rho = mean(d$rho), sd_rho = sd(d$rho), q025_rho = q(d$rho, 0.025),
               q975_rho = q(d$rho, 0.975), prop_rho_gt1 = mean(d$rho > 1),
               param_source = gb$source)
  }))
  write.csv(smry, f_sum, row.names = FALSE)                 # çıktı 1
  print(smry[, c("base", "scenario", "level", "ranking", "mean_C", "mean_rho", "sd_rho", "prop_rho_gt1")], digits = 3)

  if (RUN_S5) {                                             # S5: permütasyon testi
    prow <- list()
    for (bn in names(gb$bases)) {
      cp <- gb$bases[[bn]]; s0 <- median(cp$sigma^2); cp <- prefilter(cp, M_REP, s0); n <- n_rep_of[[bn]]
      for (kap in c(0, 0.5)) {                              # 0 = yanlış alarm, 0.5 = güç
        cat(sprintf("S5 permütasyon testi: %s kappa=%.1f ...\n", bn, kap))
        pv <- replicate(R_PERM_SIM, {
          l1 <- sim_lab(cp, n, kap * cp$sigma); l2 <- sim_lab(cp, n, kap * cp$sigma)
          perm_test(l1, l2, "LFC", s0)
        })
        prow[[length(prow) + 1]] <- data.frame(base = bn, kappa = kap, n_rep = R_PERM_SIM, B_perm = B_PERM,
                                               reject_05 = mean(pv <= 0.05), reject_10 = mean(pv <= 0.10),
                                               param_source = gb$source)
      }
    }
    write.csv(do.call(rbind, prow), f_perm, row.names = FALSE)  # çıktı 3
    print(do.call(rbind, prow))
  }
  cat(sprintf("step05 bitti. Süre: %.1f dakika\n", as.numeric(difftime(Sys.time(), t5, units = "mins"))))
}


# ---------------------------------------------------------------------
# step06: GERÇEK VERİDE ÇIKARIM
#  (a) Her gerçek laboratuvar çifti için permütasyon testi: H0 = laboratuvar etkisi yok
#      (tekrarlar iki laboratuvar arasında rastgele karıştırılır, rho yeniden hesaplanır)
#  (b) Kalibrasyon eğrileri: sahte laboratuvarlarda kappa = 0 ... 3 için rho_hat dağılımı
#  (c) Her çift için kappa tahmini ve %95 güven aralığı (test ters çevirme):
#      gözlenen rho_hat'i "olağan" kılan kappa değerleri = güven aralığı
#  Güvenilirlik: iki tavan da >= 0.20 değilse test yapılmaz (step05 S4 sonucu)
# ---------------------------------------------------------------------
REDO_STEP06  <- FALSE       # TRUE: step06 yeniden hesaplanır
RHO_MIN_C6   <- 0.20        # güvenilirlik eşiği (step05 S4'e göre 0.10 -> 0.20)
B_PERM_REAL  <- 99          # gerçek çiftlerde permütasyon sayısı (p-değeri çözünürlüğü 0.01)
SPL_REAL     <- 30          # gerçek çiftlerde tavan için bölme sayısı
BTW_REAL     <- 30          # gerçek çiftlerde laboratuvarlar arası çekiliş sayısı
G_KEEP_REAL  <- 5000        # hız için gerçek veride tutulan gen sayısı (her sıralama için)
KAPPA_GRID   <- c(0, 0.25, 0.5, 0.75, 1, 1.5, 2, 3)  # kalibrasyon eğrisi için kappa değerleri
R_CURVE      <- 150         # her kappa için sahte çift sayısı
RUN_S5_BIG   <- FALSE       # TRUE: permütasyon testinin 500 tekrarlı büyük simülasyonu (çok uzun; gece çalıştırın)

f_pairs  <- "step06_real_pairs.csv"                         # çıktı 1: gerçek çiftler: rho, p, kappa, güven aralığı
f_curves <- "step06_kappa_curves.csv"                       # çıktı 2: kalibrasyon eğrileri
f_fchk   <- "step06_filter_check.csv"                       # çıktı 3: gen filtresi kontrolü
f_big    <- "step06_perm_sim_big.csv"                       # (isteğe bağlı) büyük S5 simülasyonu

configs6 <- data.frame(                                     # analiz edilecek veri x karşılaştırma x sıralama
  dataset  = c("MAQC", "MAQC", "MAQC", "SEQC", "SEQC"),
  contrast = c("A-B",  "A-B",  "C-D",  "A-B",  "A-B"),
  ranking  = c("LFC",  "modT", "LFC",  "LFC",  "modT"))     # SEQC C-D ve MAQC C-D modT: tavanlar çok düşük, çıkarıldı

# --- 6a) Gerçek veri için gen filtresi (ilk-100'e girme şansı olmayanları at) ---
prefilter_real <- function(labs, g1, g2, s0) {
  opt <- sapply(labs, function(l) {                         # her laboratuvarda iyimser skor
    d  <- abs(rowMeans(l[[g1]]) - rowMeans(l[[g2]]))        # tüm tekrarlarla LFC
    s2 <- (rowSums((l[[g1]] - rowMeans(l[[g1]]))^2) + rowSums((l[[g2]] - rowMeans(l[[g2]]))^2)) /
          (ncol(l[[g1]]) + ncol(l[[g2]]) - 2)
    cbind(lfc = d + 3 * sqrt(s2 * 2 / M_REP),               # LFC için iyimser
          t   = (d + 3 * sqrt(s2 * 2 / M_REP)) / sqrt((s2 + s0) * 2 / M_REP))  # düzenlenmiş t için iyimser
  }, simplify = "array")                                    # gen x 2 x lab
  ol <- apply(opt[, 1, , drop = FALSE], 1, max); ot <- apply(opt[, 2, , drop = FALSE], 1, max)  # laboratuvarlar üzerinden en büyük
  K <- min(G_KEEP_REAL, length(ol))
  sort(union(order(-ol)[1:K], order(-ot)[1:K]))             # tutulacak genlerin sıra numaraları
}
sub_lab <- function(l, g1, g2, keep) list(A = l[[g1]][keep, , drop = FALSE], B = l[[g2]][keep, , drop = FALSE])

# --- 6b) Gerçek çift için permütasyon testi ---
perm_test_real <- function(l1, l2, ranking, s0) {
  obs <- rho_pair(l1, l2, ranking, s0, SPL_REAL, BTW_REAL)  # gözlenen C1, C2, E, rho
  if (min(obs[["C1"]], obs[["C2"]]) < RHO_MIN_C6) return(c(obs, p = NA))  # güvenilmezse test yapma
  n1 <- ncol(l1$A); m1 <- ncol(l1$B)
  pA <- cbind(l1$A, l2$A); pB <- cbind(l1$B, l2$B)          # tekrarları havuzla
  perm <- replicate(B_PERM_REAL, {
    ia <- sample(ncol(pA)); ib <- sample(ncol(pB))          # tekrarları rastgele iki sahte laboratuvara dağıt
    rho_pair(list(A = pA[, ia[1:n1], drop = FALSE], B = pB[, ib[1:m1], drop = FALSE]),
             list(A = pA[, ia[-(1:n1)], drop = FALSE], B = pB[, ib[-(1:m1)], drop = FALSE]),
             ranking, s0, SPL_REAL, BTW_REAL)[["rho"]]
  })
  c(obs, p = (1 + sum(perm <= obs[["rho"]])) / (B_PERM_REAL + 1))  # tek yönlü p
}

# --- 6c) Kalibrasyon eğrisinden kappa tahmini ve güven aralığı (test ters çevirme) ---
kappa_ci <- function(obs, cv) {                             # cv: bir yapılandırmanın eğrisi (kappa, mean, q025, q975)
  cv <- cv[order(cv$kappa), ]
  mn <- cummin(cv$mean_rho)                                 # ortalama rho kappa ile azalır (monoton yap)
  fine <- seq(min(cv$kappa), max(cv$kappa), by = 0.01)      # ince kappa ızgarası
  mf <- approx(cv$kappa, mn, fine)$y; lo <- approx(cv$kappa, cv$q025_rho, fine)$y; hi <- approx(cv$kappa, cv$q975_rho, fine)$y
  acc <- fine[lo <= obs & obs <= hi]                        # gözlenen değeri olağan kılan kappa'lar
  k_hat <- if (obs >= mf[1]) 0 else if (obs < min(mf)) NA else fine[which(mf <= obs)[1]]  # nokta tahmini
  k_lo <- if (length(acc)) min(acc) else NA; k_hi <- if (length(acc)) max(acc) else NA
  rho_at <- function(k) if (is.na(k)) NA else min(1, approx(fine, mf, k)$y)  # o kappa'daki gerçek rho
  c(kappa_hat = k_hat, kappa_lo = k_lo, kappa_hi = k_hi,
    kappa_beyond_grid = obs < min(lo, na.rm = TRUE),        # gözlenen rho, kappa=3'te bile beklenenden düşük mü
    rho_lo = rho_at(k_hi), rho_hi = rho_at(k_lo))
}

# --- 6d) Çalıştır ---
if (!REDO_STEP06 && all(file.exists(c(f_pairs, f_curves)))) {
  cat("step06 çıktıları mevcut, atlanıyor (yeniden için REDO_STEP06 <- TRUE).\n")
} else {
  t6 <- Sys.time(); set.seed(20261028)
  par6 <- if (file.exists(f_par)) readRDS(f_par) else stop("step04_calib_params.rds yok; önce step04 çalışmalı")
