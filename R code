two_sets <- function(n) combn(n, 2, simplify = FALSE)
lab_cache <- function(lab) {
  SA <- two_sets(ncol(lab$A)); SB <- two_sets(ncol(lab$B))
  L <- vector("list", length(SA) * length(SB)); key <- character(length(L)); z <- 0
  for (i in seq_along(SA)) for (j in seq_along(SB)) { z <- z + 1
    L[[z]] <- top_k(score_fun(lab$A[, SA[[i]], drop = FALSE], lab$B[, SB[[j]], drop = FALSE], "LFC"), K_LIST)
    key[z] <- paste(paste(SA[[i]], collapse = ""), paste(SB[[j]], collapse = ""), sep = "|") }
  names(L) <- key; L
}
k_of <- function(a, b) paste(paste(sort(a), collapse = ""), paste(sort(b), collapse = ""), sep = "|")
ceiling_all <- function(lab, LC, okA = NULL, okB = NULL) {
  PA <- disjoint_pairs(ncol(lab$A), 2); PB <- disjoint_pairs(ncol(lab$B), 2, ordered = TRUE)
  if (!is.null(okA)) PA <- Filter(okA, PA); if (!is.null(okB)) PB <- Filter(okB, PB)
  r <- c(); for (a in PA) for (b in PB) r <- c(r, rbo_lists(LC[[k_of(a[[1]], b[[1]])]], LC[[k_of(a[[2]], b[[2]])]]))
  c(C = mean(r), n = length(r))
}
between_all <- function(L1, L2) mean(outer(seq_along(L1), seq_along(L2), Vectorize(function(i, j) rbo_lists(L1[[i]], L2[[j]]))))

if (!REDO_STEP12 && all(file.exists(c(f12a, f12b, f12c, f12d))) && (!RUN_12C || file.exists(f12e))) {
  cat("step12 outputs exist, skipping (set REDO_STEP12 <- TRUE to rerun).\n")
} else {
  t12 <- Sys.time(); set.seed(20261103)
  par10 <- readRDS(f_par); ds10 <- list()
  if (file.exists(f_maqc)) ds10$MAQC <- prep_maqc(readRDS(f_maqc))
  if (file.exists(f_seqc)) ds10$SEQC <- prep_seqc(readRDS(f_seqc))

  # ---- 12a: exact C, E and rho over all splits ----
  if (need12(f12a) || need12(f12b) || need12(f12c)) {
    pa12 <- list(); ce12 <- list(); mb12 <- list()
    bd <- read.csv(f_bdiag, colClasses = c(part_A = "character", part_B = "character"))
    for (i in seq_len(nrow(configs7))) {
      cf <- configs7[i, ]; if (is.null(ds10[[cf$dataset]])) next
      cat(sprintf("12a: %s %s - all splits...\n", cf$dataset, cf$contrast))
      rl <- real_labs(cf$dataset, cf$contrast); labs <- rl$labs
      LC <- lapply(labs, lab_cache)
      Cv <- sapply(names(labs), function(l) ceiling_all(labs[[l]], LC[[l]]))
      for (l in names(labs)) ce12[[length(ce12) + 1]] <- data.frame(dataset = cf$dataset, contrast = cf$contrast,
        lab = l, C = Cv["C", l], n_splits = Cv["n", l])
      pr <- combn(names(labs), 2)
      for (j in seq_len(ncol(pr))) { a <- pr[1, j]; b <- pr[2, j]
        E <- between_all(LC[[a]], LC[[b]]); C1 <- Cv["C", a]; C2 <- Cv["C", b]
        pa12[[length(pa12) + 1]] <- data.frame(dataset = cf$dataset, contrast = cf$contrast, ranking = "LFC",
          lab1 = a, lab2 = b, C1 = C1, C2 = C2, E = E, rho_hat = E / sqrt(C1 * C2),
          reliable = min(C1, C2) >= RHO_MIN_C6) }
      if (cf$contrast == "A-B") for (r in which(bd$dataset == cf$dataset & bd$batch_flag)) {
        ln <- bd$lab[r]; gA <- as.integer(strsplit(bd$part_A[r], "")[[1]]); gB <- as.integer(strsplit(bd$part_B[r], "")[[1]])
        balA <- function(s) length(unique(gA[s])) == 2; balB <- function(s) length(unique(gB[s])) == 2
        okA <- function(p) balA(p[[1]]) && balA(p[[2]]); okB <- function(p) balB(p[[1]]) && balB(p[[2]])
        Cb <- ceiling_all(labs[[ln]], LC[[ln]], okA, okB)
        SA <- two_sets(ncol(labs[[ln]]$A)); SB <- two_sets(ncol(labs[[ln]]$B))
        keepk <- unlist(lapply(SA, function(a) lapply(SB, function(b) if (balA(a) && balB(b)) k_of(a, b) else NULL)))
        Lbal <- LC[[ln]][keepk]
        for (o in setdiff(names(labs), ln)) {
          Es <- between_all(LC[[ln]], LC[[o]]); Eb <- between_all(Lbal, LC[[o]])
          mb12[[length(mb12) + 1]] <- data.frame(dataset = cf$dataset, batch_lab = ln, other_lab = o, C_other = Cv["C", o],
            C_standard = Cv["C", ln], E_standard = Es, rho_standard = Es / sqrt(Cv["C", ln] * Cv["C", o]),
            C_batch_aware = Cb[["C"]], E_batch_aware = Eb, rho_batch_aware = Eb / sqrt(Cb[["C"]] * Cv["C", o]),
            n_balanced_splits = Cb[["n"]], n_balanced_lists = length(Lbal))
        }
      }
    }
    write.csv(do.call(rbind, pa12), f12a, row.names = FALSE); write.csv(do.call(rbind, ce12), f12b, row.names = FALSE)
    write.csv(if (length(mb12)) do.call(rbind, mb12) else data.frame(note = "no laboratory with batch structure"), f12c, row.names = FALSE)
    print(do.call(rbind, ce12), digits = 3); if (length(mb12)) print(do.call(rbind, mb12), digits = 3)

    cv12 <- read.csv(f_curves); cv12$label <- cfg_label(cv12$dataset, cv12$contrast); cv12 <- cv12[cv12$ranking == "LFC", ]
    nb12 <- cv12[cv12$kappa == 0, c("label", "q025_rho", "q975_rho")]
    rp12 <- read.csv(f12a); rp12$label <- cfg_label(rp12$dataset, rp12$contrast)
    cal12 <- read.csv(f_cal); fl12 <- setNames(cal12$floor_rbo, cfg_label(cal12$dataset, cal12$contrast))
    set.seed(9)
    save_fig("Fig2", 6.8, 3.8, fig2(rp12, fl12))
    save_fig("Fig3", 7.2, 3.8, fig3(rp12, nb12))
    bp12 <- read.csv(f12c); if ("rho_standard" %in% names(bp12))
      save_fig("Fig5", 6.5, 3.6, fig5(bp12, nb12[nb12$label == "SEQC A vs B", ]))
  }

  # ---- 12b: SEQC C vs D global test ----
  if (need12(f12d) && !is.null(ds10$SEQC)) {
    rl <- real_labs("SEQC", "C-D"); labs_cd <- rl$labs; s0_cd <- rl$s0
    cat(sprintf("12b: SEQC C-D global test, %d permutations...\n", B_CD12))
    st <- all_stats(labs_cd, "LFC", s0_cd)
    perm <- unlist(run_reps(B_CD12, function(r) all_stats(permute_labs(labs_cd), "LFC", s0_cd)$glob))
    p <- (1 + sum(perm <= st$glob)) / (length(perm) + 1)
    write.csv(data.frame(dataset = "SEQC", contrast = "C-D", n_labs = length(labs_cd), C_min = min(st$C), C_max = max(st$C),
      T_obs = st$glob, T_perm_mean = mean(perm), T_perm_q025 = quantile(perm, 0.025, names = FALSE),
      T_perm_q975 = quantile(perm, 0.975, names = FALSE), p_global = p, mc_se = sqrt(p * (1 - p) / length(perm)), B = length(perm)),
      f12d, row.names = FALSE)
    print(read.csv(f12d), digits = 3)
  }

  # ---- 12c: power simulation ----
  if (RUN_12C && need12(f12e)) {
    sim_lab_sparse <- function(cp, n, frac = 0.1, kap = 2) {
      b <- ifelse(runif(nrow(cp)) < frac, rnorm(nrow(cp), 0, kap * cp$sigma), 0)
      list(A = (cp$mu + b) / 2 + cp$sigma * matrix(rnorm(nrow(cp) * n), nrow(cp)),
           B = -(cp$mu + b) / 2 + cp$sigma * matrix(rnorm(nrow(cp) * n), nrow(cp)))
    }
    sc12 <- data.frame(name = c("null", "kappa_0.25", "kappa_0.5", "sparse_10pct_kappa_2"), kap = c(0, 0.25, 0.5, NA))
    pw <- if (file.exists(f12e) && !REDO_STEP12) read.csv(f12e, stringsAsFactors = FALSE) else NULL
    for (bn in c("MAQC", "SEQC")) for (si in seq_len(nrow(sc12))) {
      if (!is.null(pw) && any(pw$base == bn & pw$scenario == sc12$name[si])) next
      cp_p <- par10[[paste(bn, "A-B")]]; cp_p <- prefilter(cp_p, M_REP, median(cp_p$sigma^2)); n_p <- n_rep_of[[bn]]; s_p <- sc12[si, ]
      cat(sprintf("12c: %s %s (%d data sets x %d permutations)...\n", bn, s_p$name, R_POW12, B_POW12))
      res <- run_reps(R_POW12, function(r) {
        labs_s <- lapply(1:6, function(l) if (is.na(s_p$kap)) sim_lab_sparse(cp_p, n_p) else sim_lab(cp_p, n_p, s_p$kap * cp_p$sigma))
        obs <- glob_stat_n(labs_s, SPL10, BTW10)
        perm <- replicate(B_POW12, glob_stat_n(permute_labs(labs_s), SPL10, BTW10))
        c(T = obs, p = (1 + sum(perm <= obs)) / (B_POW12 + 1))
      }, n_serial = R_POW12_SER)
      v <- do.call(rbind, res); k5 <- sum(v[, "p"] <= 0.05); nn <- nrow(v)
      ci <- binom.test(k5, nn)$conf.int
      pw <- rbind(pw, data.frame(base = bn, scenario = s_p$name, n_labs = 6, n_rep_per_sample = n_p, n_sim = nn, B_perm = B_POW12,
        mean_T = mean(v[, "T"]), reject_05 = k5 / nn, ci_low = ci[1], ci_high = ci[2], reject_10 = mean(v[, "p"] <= 0.10)))
      write.csv(pw, f12e, row.names = FALSE)
    }
    print(pw, digits = 3)
  }
  cat(sprintf("step12 done. Time: %.1f min\n", as.numeric(difftime(Sys.time(), t12, units = "mins"))))
}
