  if ("rho_standard" %in% names(bp)) save_fig("Fig5", 6.5, 3.6, fig5(bp, nullband[nullband$label == "SEQC A vs B", ]))

  # Tablo 1: veri tasarımı + simülasyon gerçekçilik kontrolü (LFC, A vs B ve C vs D)
  md <- read.csv(f_mdes); sdz <- read.csv(f_sdes); sdz <- sdz[sdz$platform == "Illumina" & sdz$samp %in% c("A", "B", "C", "D"), ]
  t1 <- do.call(rbind, lapply(split(rp, rp$label), function(d) {
    Cl <- tapply(c(d$C1, d$C2), c(d$lab1, d$lab2), mean); nm <- d$label[1]; ds <- d$dataset[1]
