REDO_STEP06  <- FALSE  # TRUE recomputes the step
RHO_MIN_C6   <- 0.20  # reliability threshold for the ceilings
B_PERM_REAL  <- 99  # permutations for real pairs
SPL_REAL     <- 30  # splits per laboratory
BTW_REAL     <- 30  # between-laboratory draws
G_KEEP_REAL  <- 5000  # genes kept per ranking
KAPPA_GRID   <- c(0, 0.25, 0.5, 0.75, 1, 1.5, 2, 3)  # kappa values for the calibration curves
R_CURVE      <- 150  # synthetic pairs per kappa
RUN_S5_BIG   <- FALSE  # large permutation simulation (very slow)

f_pairs  <- "step06_real_pairs.csv"
f_curves <- "step06_kappa_curves.csv"
f_fchk   <- "step06_filter_check.csv"
f_big    <- "step06_perm_sim_big.csv"

configs6 <- data.frame(
  dataset  = c("MAQC", "MAQC", "MAQC", "SEQC", "SEQC"),
  contrast = c("A-B",  "A-B",  "C-D",  "A-B",  "A-B"),
  ranking  = c("LFC",  "modT", "LFC",  "LFC",  "modT"))

prefilter_real <- function(labs, g1, g2, s0) {
  opt <- sapply(labs, function(l) {
    d  <- abs(rowMeans(l[[g1]]) - rowMeans(l[[g2]]))
    s2 <- (rowSums((l[[g1]] - rowMeans(l[[g1]]))^2) + rowSums((l[[g2]] - rowMeans(l[[g2]]))^2)) /
          (ncol(l[[g1]]) + ncol(l[[g2]]) - 2)
    cbind(lfc = d + 3 * sqrt(s2 * 2 / M_REP),
          t   = (d + 3 * sqrt(s2 * 2 / M_REP)) / sqrt((s2 + s0) * 2 / M_REP))
  }, simplify = "array")
  ol <- apply(opt[, 1, , drop = FALSE], 1, max); ot <- apply(opt[, 2, , drop = FALSE], 1, max)
  K <- min(G_KEEP_REAL, length(ol))
  sort(union(order(-ol)[1:K], order(-ot)[1:K]))
}
sub_lab <- function(l, g1, g2, keep) list(A = l[[g1]][keep, , drop = FALSE], B = l[[g2]][keep, , drop = FALSE])

perm_test_real <- function(l1, l2, ranking, s0) {
  obs <- rho_pair(l1, l2, ranking, s0, SPL_REAL, BTW_REAL)
  if (min(obs[["C1"]], obs[["C2"]]) < RHO_MIN_C6) return(c(obs, p = NA))
  n1 <- ncol(l1$A); m1 <- ncol(l1$B)
  pA <- cbind(l1$A, l2$A); pB <- cbind(l1$B, l2$B)
  perm <- replicate(B_PERM_REAL, {
    ia <- sample(ncol(pA)); ib <- sample(ncol(pB))
    rho_pair(list(A = pA[, ia[1:n1], drop = FALSE], B = pB[, ib[1:m1], drop = FALSE]),
             list(A = pA[, ia[-(1:n1)], drop = FALSE], B = pB[, ib[-(1:m1)], drop = FALSE]),
             ranking, s0, SPL_REAL, BTW_REAL)[["rho"]]
  })
  c(obs, p = (1 + sum(perm <= obs[["rho"]])) / (B_PERM_REAL + 1))
}

kappa_ci <- function(obs, cv) {
  cv <- cv[order(cv$kappa), ]
  mn <- cummin(cv$mean_rho)
  fine <- seq(min(cv$kappa), max(cv$kappa), by = 0.01)
  mf <- approx(cv$kappa, mn, fine)$y; lo <- approx(cv$kappa, cv$q025_rho, fine)$y; hi <- approx(cv$kappa, cv$q975_rho, fine)$y
  acc <- fine[lo <= obs & obs <= hi]
  k_hat <- if (obs >= mf[1]) 0 else if (obs < min(mf)) NA else fine[which(mf <= obs)[1]]
  k_lo <- if (length(acc)) min(acc) else NA; k_hi <- if (length(acc)) max(acc) else NA
  rho_at <- function(k) if (is.na(k)) NA else min(1, approx(fine, mf, k)$y)
  c(kappa_hat = k_hat, kappa_lo = k_lo, kappa_hi = k_hi,
    kappa_beyond_grid = obs < min(lo, na.rm = TRUE),
    rho_lo = rho_at(k_hi), rho_hi = rho_at(k_lo))
}

