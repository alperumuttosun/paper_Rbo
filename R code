bioc_ok <- function(pkg) {
  if (requireNamespace(pkg, quietly = TRUE)) return(TRUE)
  tryCatch({
    if (!requireNamespace("BiocManager", quietly = TRUE))
      install.packages("BiocManager")
    BiocManager::install(pkg, ask = FALSE, update = FALSE)
  }, error = function(e) NULL)
  requireNamespace(pkg, quietly = TRUE)
}

download_tmp <- function(url) {
  dest <- file.path(tempdir(), basename(url))
  if (!file.exists(dest)) download.file(url, dest, mode = "wb", quiet = TRUE)
  dest
}

list_remote_files <- function(dir_url) {
  html <- readLines(dir_url, warn = FALSE)
  m <- regmatches(html, gregexpr('href="[^"?/]+"', html))
  unique(gsub('href="|"', "", unlist(m)))
}

read_series_matrix <- function(gz_file) {
  L <- readLines(gzfile(gz_file), warn = FALSE)
  field <- function(tag) {
    x <- L[startsWith(L, tag)]
    if (length(x) == 0) return(NULL)
    lapply(x, function(s) gsub('"', "", strsplit(s, "\t")[[1]][-1]))
  }
  title <- field("!Sample_title")[[1]]
  gsm   <- field("!Sample_geo_accession")[[1]]
  ch    <- field("!Sample_characteristics_ch1")
  chars <- if (is.null(ch)) rep("", length(gsm)) else
    apply(do.call(cbind, ch), 1, paste, collapse = "; ")
  b <- which(L == "!series_matrix_table_begin")
  e <- which(L == "!series_matrix_table_end")
  tab <- read.delim(text = L[(b + 1):(e - 1)], check.names = FALSE, quote = '"')
  X <- as.matrix(tab[, -1, drop = FALSE]); rownames(X) <- tab[[1]]
  list(expr = X, info = data.frame(sample_id = gsm, title = title, chars = chars))
}

parse_maqc_titles <- function(info) {
  s <- paste(info$title, info$chars)
  m <- regmatches(s, regexec("AFX[_ ]?([0-9]+)[_ ]?([A-D])[_ ]?([0-9]+)", s))
  get <- function(i) sapply(m, function(z) if (length(z) == 4) z[i] else NA)
  data.frame(sample_id = info$sample_id, site = get(2), samp = get(3), repl = get(4))
}

maqc_way_A <- function() {
  if (!bioc_ok("Biobase") || !bioc_ok("MAQCsubset")) stop("MAQCsubset/Biobase could not be installed")
  suppressPackageStartupMessages(library(Biobase))
  e <- new.env()
  data("afxsubRMAES", package = "MAQCsubset", envir = e)
  es <- e$afxsubRMAES
  X  <- Biobase::exprs(es)
  pd <- Biobase::pData(es)
  list(expr = X,
       pheno = data.frame(sample_id = colnames(X), site = as.character(pd$site),
                          samp = as.character(pd$samp), repl = as.character(pd$repl)),
       source = "MAQCsubset::afxsubRMAES (RMA)", way = "A")
}

maqc_way_B <- function() {
  gz <- tryCatch(download_tmp(url_maqc_B), error = function(e) NULL)
  if (is.null(gz)) {
    fl <- list_remote_files(url_maqc_dir)
    fl <- fl[grepl("GPL570", fl) & grepl("series_matrix", fl)]
    if (length(fl) == 0) stop("GPL570 series matrix not found in GSE5350")
    gz <- download_tmp(paste0(url_maqc_dir, fl[1]))
  }
  sm <- read_series_matrix(gz)
  ph <- parse_maqc_titles(sm$info)
  if (all(is.na(ph$site))) {
    write.csv(head(sm$info, 30), "step03_maqc_pheno_head.csv", row.names = FALSE)
    stop("Sample titles could not be parsed; see step03_maqc_pheno_head.csv")
  }
  list(expr = sm$expr, pheno = ph, source = "GEO GSE5350 GPL570 series matrix", way = "B")
}

seqc_way_A <- function() {
  if (!bioc_ok("seqc")) stop("seqc package could not be installed")
  objs <- paste0("ILM_refseq_gene_", seqc_sites)
  getd <- function(o) tryCatch(getExportedValue("seqc", o),
    error = function(e) { en <- new.env(); data(list = o, package = "seqc", envir = en); en[[o]] })
  ilm <- setNames(lapply(objs, getd), seqc_sites)
  list(ilm = ilm, taqman = getd("taqman"), source = "Bioconductor seqc (RefSeq gene counts)", way = "A")
}

seqc_way_B <- function() {
  fl <- list_remote_files(url_seqc_dir)
  write.csv(data.frame(file = fl), "step03_seqc_geo_files.csv", row.names = FALSE)
  fl <- fl[grepl("ILM", fl, ignore.case = TRUE)]
  site_of <- sapply(fl, function(f) {
    hit <- seqc_sites[sapply(seqc_sites, grepl, x = f)]; if (length(hit)) hit[1] else NA })
  fl <- fl[!is.na(site_of)]; site_of <- site_of[!is.na(site_of)]
  if (length(fl) == 0) stop("Illumina site files not found in GSE47774; see step03_seqc_geo_files.csv")
  keep <- !duplicated(site_of)
  ilm <- lapply(fl[keep], function(f) read.delim(download_tmp(paste0(url_seqc_dir, f)), check.names = FALSE))
  names(ilm) <- site_of[keep]
  list(ilm = ilm, taqman = NULL, source = "GEO GSE47774 supplementary", way = "B")
}

maqc_design <- function(m) {
  ph <- m$pheno[!is.na(m$pheno$site), ]
  d  <- aggregate(sample_id ~ site + samp, data = ph, FUN = length)
  names(d)[3] <- "n_replicates"
  cbind(source = m$source, way = m$way, n_probes = nrow(m$expr), d)
}

parse_lib_cols <- function(cn) {
  m <- regmatches(cn, regexec("(?:^|_)([A-F])_([0-9]+)_(L[0-9]+|R[0-9]+)", cn, perl = TRUE))
  ok <- sapply(m, length) == 4
  data.frame(col = cn[ok], samp = sapply(m[ok], `[`, 2),
             repl = sapply(m[ok], `[`, 3), lane = sapply(m[ok], `[`, 4))
}

seqc_design <- function(s) {
  out <- list()
  for (site in names(s$ilm)) {
    tb <- s$ilm[[site]]
    pc <- parse_lib_cols(colnames(tb))
    if (nrow(pc) == 0) next
    is_ercc <- if ("IsERCC" %in% names(tb)) as.logical(tb$IsERCC) else rep(FALSE, nrow(tb))
    agg <- aggregate(lane ~ samp, data = pc, FUN = length)
    rep <- aggregate(repl ~ samp, data = pc, FUN = function(z) length(unique(z)))
    out[[site]] <- data.frame(platform = "Illumina", site = site, samp = agg$samp,
                              n_replicates = rep$repl, n_lane_columns = agg$lane,
                              n_genes = sum(!is_ercc), source = s$source, way = s$way)
  }
  if (!is.null(s$taqman)) {
    tv <- grep("_value$", colnames(s$taqman), value = TRUE)
    sm <- substr(tv, 1, 1)
    out[["TaqMan"]] <- data.frame(platform = "TaqMan", site = "TaqMan",
                                  samp = names(table(sm)), n_replicates = as.vector(table(sm)),
                                  n_lane_columns = NA, n_genes = nrow(s$taqman),
                                  source = s$source, way = s$way)
  }
  do.call(rbind, out)
}

