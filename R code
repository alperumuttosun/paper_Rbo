run_reps <- function(n, fun, n_serial = n) {
  out <- NULL
  if (N_CORES > 1) out <- tryCatch({
    cl <- parallel::makeCluster(N_CORES)
    on.exit(parallel::stopCluster(cl), add = TRUE)
    vars <- Filter(function(v) { o <- get(v, envir = globalenv())
                                 is.function(o) || as.numeric(object.size(o)) < 5e7 }, ls(globalenv()))
    parallel::clusterExport(cl, vars, envir = globalenv())
    parallel::clusterSetRNGStream(cl, sample.int(1e9, 1))
    parallel::parLapply(cl, seq_len(n), fun)
  }, error = function(e) { cat("  parallel run failed, continuing serially:", conditionMessage(e), "\n"); NULL })
  if (is.null(out)) out <- lapply(seq_len(n_serial), fun)
  out
}
real_labs <- function(dsn, ctn) {
  g <- strsplit(ctn, "-")[[1]]; labs0 <- ds10[[dsn]]
  s0 <- median(par10[[paste(dsn, ctn)]]$sigma^2); keep <- prefilter_real(labs0, g[1], g[2], s0)
  list(labs = lapply(labs0, sub_lab, g1 = g[1], g2 = g[2], keep = keep), s0 = s0, labs0 = labs0, g = g)
}

lab_lists_n <- function(lab, spl, btw) {
  C <- mean(replicate(spl, { ia <- sample(ncol(lab$A)); ib <- sample(ncol(lab$B))
    rbo_lists(list_sim(lab, ia[1:M_REP], ib[1:M_REP], "LFC", 0),
              list_sim(lab, ia[M_REP + 1:M_REP], ib[M_REP + 1:M_REP], "LFC", 0)) }))
  pool <- replicate(btw, list_sim(lab, sample(ncol(lab$A), M_REP), sample(ncol(lab$B), M_REP), "LFC", 0), simplify = FALSE)
  list(C = C, pool = pool)
}
glob_stat_n <- function(labs, spl, btw) {
  ll <- lapply(labs, lab_lists_n, spl = spl, btw = btw); L <- length(labs); r <- c()
  for (i in 1:(L - 1)) for (j in (i + 1):L)
    r <- c(r, mean(mapply(rbo_lists, ll[[i]]$pool, ll[[j]]$pool)) / sqrt(ll[[i]]$C * ll[[j]]$C))
  mean(r)
}

if (!REDO_STEP10 && all(file.exists(c(f10a, f10b, f10c, f10d, f10e, f10f, f10g)))) {
  cat("step10 outputs exist, skipping (set REDO_STEP10 <- TRUE to rerun).\n")
} else {
  t10 <- Sys.time(); set.seed(20261101)
  par10 <- readRDS(f_par)
  ds10 <- list()
  if (file.exists(f_maqc)) ds10$MAQC <- prep_maqc(readRDS(f_maqc))
  if (file.exists(f_seqc)) ds10$SEQC <- prep_seqc(readRDS(f_seqc))
  K0 <- K_LIST; P0 <- P_RBO

  # ---- 10a: null grid check ----
  if (need10(f10a)) {
    cat("10a: null grid check...\n")
    exact_enum <- function(N, k, w) {
      W <- rev(cumsum(rev(w))); st <- list(`0` = c(`0` = 1))
      for (d in seq_len(k)) {
        new <- list()
        for (xs in names(st)) {
          x <- as.integer(xs); pr <- step_probs(x, d - 1, N)
          for (inc in 0:2) {
            if (x + inc > d || pr[inc + 1] <= 0) next
            sc <- round(as.numeric(names(st[[xs]])) + inc * W[d], 12)
            key <- as.character(x + inc); v <- pr[inc + 1] * st[[xs]]
            new[[key]] <- c(new[[key]], setNames(v, sc))
          }
        }
        st <- lapply(new, function(v) tapply(v, names(v), sum))
        st <- lapply(st, function(v) setNames(as.numeric(v), names(v)))
      }
      v <- unlist(unname(st)); s <- as.numeric(names(v)); a <- tapply(v, s, sum)
      data.frame(score = as.numeric(names(a)), prob = as.numeric(a))
    }
    ga <- list()
    for (pp in c(0.9, 0.98)) for (kk in c(8, 10)) {
      w <- rbo_weights(kk, pp, "ext"); ex <- exact_enum(200, kk, w)
      ex <- ex[order(ex$score), ]; ex$upper <- rev(cumsum(rev(ex$prob)))
      dg <- null_dist_dp(200, kk, w, NULL, N_BINS)
      pg <- pvalue_dp(ex$score, dg)
      okp <- ex$upper >= 1e-6
      ga[[length(ga) + 1]] <- data.frame(check = "grid vs exact enumeration", N = 200, k = kk, p = pp,
        n_bins = N_BINS, n_support = nrow(ex), max_abs_p_diff = max(abs(pg[okp] - ex$upper[okp])),
        max_rel_p_diff = max(abs(pg[okp] - ex$upper[okp]) / ex$upper[okp]),
        mean_exact = sum(ex$score * ex$prob), mean_grid = sum(dg$value * dg$prob),
        score_error_bound = kk * dg$h / 2)
    }
    for (NN in c(17260, 41006)) {
      w <- rbo_weights(100, 0.98, "ext")
      d1 <- null_dist_dp(NN, 100, w, NULL, 20000); d2 <- null_dist_dp(NN, 100, w, NULL, 80000)
      tt <- quantile_dp(c(0.5, 0.9, 0.95, 0.99, 0.999, 0.9999), d2)
      p1 <- pvalue_dp(tt, d1); p2 <- pvalue_dp(tt, d2)
      ga[[length(ga) + 1]] <- data.frame(check = "20000 vs 80000 cells", N = NN, k = 100, p = 0.98,
        n_bins = 20000, n_support = NA, max_abs_p_diff = max(abs(p1 - p2)), max_rel_p_diff = max(abs(p1 - p2) / p2),
        mean_exact = null_moments_exact(NN, 100, w)$mean, mean_grid = sum(d1$value * d1$prob),
        score_error_bound = 100 * d1$h / 2)
    }
    write.csv(do.call(rbind, ga), f10a, row.names = FALSE); print(do.call(rbind, ga), digits = 3)
  }

  # ---- 10b: global tests, B = 1999 ----
  if (need10(f10b)) {
    gb <- list()
    for (i in seq_len(nrow(configs7))) {
      cf <- configs7[i, ]; if (is.null(ds10[[cf$dataset]])) next
      rl <- real_labs(cf$dataset, cf$contrast); labs_b <- rl$labs; s0_b <- rl$s0
      cat(sprintf("10b: %s %s, %d permutations (%d cores)...\n", cf$dataset, cf$contrast, B_FINAL, N_CORES))
      obs <- all_stats(labs_b, "LFC", s0_b)$glob
      perm <- unlist(run_reps(B_FINAL, function(r) all_stats(permute_labs(labs_b), "LFC", s0_b)$glob))
      B <- length(perm); p <- (1 + sum(perm <= obs)) / (B + 1)
      gb[[length(gb) + 1]] <- data.frame(dataset = cf$dataset, contrast = cf$contrast, n_labs = length(labs_b),
        T_obs = obs, T_perm_mean = mean(perm), p_global = p, mc_se = sqrt(p * (1 - p) / B), B = B)
      write.csv(do.call(rbind, gb), f10b, row.names = FALSE)
    }
    print(do.call(rbind, gb), digits = 3)
  }

  # ---- 10c: sensitivity to k and p ----
  if (need10(f10c)) {
    kp <- data.frame(k = c(50, 200, 100, 100, 100), p = c(0.98, 0.98, 0.90, 0.95, 0.98))
    gc <- list()
    for (i in seq_len(nrow(configs7))) {
      cf <- configs7[i, ]; if (is.null(ds10[[cf$dataset]])) next
      rl <- real_labs(cf$dataset, cf$contrast); labs_c <- rl$labs; s0_c <- rl$s0
      for (j in seq_len(nrow(kp))) {
        K_LIST <- kp$k[j]; P_RBO <- kp$p[j]
        cat(sprintf("10c: %s %s, k=%d p=%.2f ...\n", cf$dataset, cf$contrast, K_LIST, P_RBO))
        st <- all_stats(labs_c, "LFC", s0_c)
        perm <- unlist(run_reps(B_SENS, function(r) all_stats(permute_labs(labs_c), "LFC", s0_c)$glob))
        gc[[length(gc) + 1]] <- data.frame(dataset = cf$dataset, contrast = cf$contrast, k = K_LIST, p_rbo = P_RBO,
          C_min = min(st$C), C_max = max(st$C), T_obs = st$glob, T_perm_mean = mean(perm),
          p_global = (1 + sum(perm <= st$glob)) / (length(perm) + 1), B = length(perm))
      }
      K_LIST <- K0; P_RBO <- P0
      write.csv(do.call(rbind, gc), f10c, row.names = FALSE)
    }
    K_LIST <- K0; P_RBO <- P0; print(do.call(rbind, gc), digits = 3)
  }

  # ---- 10d: simulation of the global test ----
  if (need10(f10d)) {
    sim_lab_corr <- function(cp, n, Lmat, b_sd = 0) {
      G <- nrow(cp); b <- rnorm(G, 0, b_sd)
      e <- function() sqrt(0.5) * matrix(rnorm(G * n), G) + sqrt(0.5) * Lmat %*% matrix(rnorm(5 * n), 5)
      list(A = (cp$mu + b) / 2 + cp$sigma * e(), B = -(cp$mu + b) / 2 + cp$sigma * e())
    }
    scen <- data.frame(name = c("null", "null_unequal_noise", "null_correlated_genes", "null_4_labs",
                                "all_labs_kappa_0.25", "all_labs_kappa_0.5", "two_labs_kappa_1"),
                       L = c(6, 6, 6, 4, 6, 6, 6))
    gd <- if (file.exists(f10d) && !REDO_STEP10) read.csv(f10d) else NULL
    for (bn in c("MAQC", "SEQC")) for (si in seq_len(nrow(scen))) {
      if (!is.null(gd) && any(gd$base == bn & gd$scenario == scen$name[si])) next
      cp_d <- par10[[paste(bn, "A-B")]]; if (is.null(cp_d)) next
      cp_d <- prefilter(cp_d, M_REP, median(cp_d$sigma^2)); n_d <- n_rep_of[[bn]]; sc_d <- scen[si, ]
      cat(sprintf("10d: %s %s (%d data sets x %d permutations)...\n", bn, sc_d$name, R_GLOB, B_GLOB_SIM))
      res <- run_reps(R_GLOB, function(r) {
        Lmat <- matrix(rnorm(nrow(cp_d) * 5, 0, sqrt(1 / 5)), nrow(cp_d))
        noise <- if (sc_d$name == "null_unequal_noise") c(0.8, 0.9, 1, 1, 1.1, 1.25) else rep(1, sc_d$L)
        kap <- switch(sc_d$name, all_labs_kappa_0.25 = rep(0.25, sc_d$L), all_labs_kappa_0.5 = rep(0.5, sc_d$L),
                      two_labs_kappa_1 = c(1, 1, rep(0, sc_d$L - 2)), rep(0, sc_d$L))
        labs_s <- lapply(seq_len(sc_d$L), function(l)
          if (sc_d$name == "null_correlated_genes") sim_lab_corr(cp_d, n_d, Lmat)
          else sim_lab(cp_d, n_d, kap[l] * cp_d$sigma, noise[l]))
        obs <- glob_stat_n(labs_s, SPL10, BTW10)
        perm <- replicate(B_GLOB_SIM, glob_stat_n(permute_labs(labs_s), SPL10, BTW10))
        c(T = obs, p = (1 + sum(perm <= obs)) / (B_GLOB_SIM + 1))
      }, n_serial = R_GLOB_SER)
      v <- do.call(rbind, res)
      gd <- rbind(gd, data.frame(base = bn, scenario = sc_d$name, n_labs = sc_d$L, n_rep_per_sample = n_d,
        n_sim = nrow(v), B_perm = B_GLOB_SIM, mean_T = mean(v[, "T"]),
        reject_05 = mean(v[, "p"] <= 0.05), reject_10 = mean(v[, "p"] <= 0.10),
        mc_se_05 = sqrt(mean(v[, "p"] <= 0.05) * (1 - mean(v[, "p"] <= 0.05)) / nrow(v))))
      write.csv(gd, f10d, row.names = FALSE)
    }
    print(gd, digits = 3)
  }

  # ---- 10e: batch diagnostic simulation ----
  if (need10(f10e)) {
    sim_lab_shared_batch <- function(cp, n, beta) {
      lab <- sim_lab(cp, n); bt <- rep(1:2, c(ceiling(n / 2), floor(n / 2)))
      for (b in 1:2) { dlt <- beta * cp$sigma * rnorm(nrow(cp))
        lab$A[, bt == b] <- lab$A[, bt == b] + dlt; lab$B[, bt == b] <- lab$B[, bt == b] + dlt }
      lab$bA <- bt; lab$bB <- bt; lab
    }
    cv10 <- read.csv(f_curves); ge <- list()
    for (bn in c("MAQC", "SEQC")) {
      cp_full <- par10[[paste(bn, "A-B")]]; if (is.null(cp_full)) next
      n_e <- n_rep_of[[bn]]; cp_e <- prefilter(cp_full, M_REP, median(cp_full$sigma^2))
      q975 <- cv10$q975_rho[cv10$dataset == bn & cv10$contrast == "A-B" & cv10$ranking == "LFC" & cv10$kappa == 0]
      for (beta in c(0, 0.25, 0.5, 1)) {
        cat(sprintf("10e: %s beta=%.2f ...\n", bn, beta))
        fl <- replicate(R_BATCH, {
          lab <- sim_lab_shared_batch(cp_full, n_e, beta)
          pa <- best_partition(rep_cor(lab$A)); pb <- best_partition(rep_cor(lab$B))
          c(flag = pa$score >= BATCH_MIN && pb$score >= BATCH_MIN && same_part(pa$g, pb$g),
            correct = same_part(pa$g, lab$bA), score = min(pa$score, pb$score))
        })
        rr <- run_reps(R_BATCH_RHO, function(r) {
          lb <- sim_lab_shared_batch(cp_e, n_e, beta); lo <- sim_lab(cp_e, n_e)
          Ls <- lab_lists_n(lb, SPL10, BTW10); Lo <- lab_lists_n(lo, SPL10, BTW10)
          Lb <- lab_lists_batch(lb, "LFC", 0)
          c(std = mean(mapply(rbo_lists, Ls$pool, Lo$pool)) / sqrt(Ls$C * Lo$C),
            bal = mean(mapply(rbo_lists, Lb$pool, Lo$pool)) / sqrt(Lb$C * Lo$C))
        }, n_serial = 40)
        rr <- do.call(rbind, rr)
        ge[[length(ge) + 1]] <- data.frame(base = bn, beta = beta, n_rep_per_sample = n_e, n_sim_flag = R_BATCH,
          flag_rate = mean(fl["flag", ]), correct_partition_rate = mean(fl["correct", ]),
          mean_min_score = mean(fl["score", ]), n_sim_rho = nrow(rr),
          mean_rho_random_split = mean(rr[, "std"]), mean_rho_balanced = mean(rr[, "bal"]),
          prop_random_above_null_q975 = mean(rr[, "std"] > q975), prop_balanced_above_null_q975 = mean(rr[, "bal"] > q975),
          null_q975 = q975)
        write.csv(do.call(rbind, ge), f10e, row.names = FALSE)
      }
    }
    print(do.call(rbind, ge), digits = 3)
  }

  # ---- 10f: comparison with other measures ----
  if (need10(f10f) || need10(f10g)) {
    has_idr <- requireNamespace("idr", quietly = TRUE)
    if (!has_idr) has_idr <- tryCatch({ install.packages("idr"); requireNamespace("idr", quietly = TRUE) },
                                      error = function(e) FALSE)
    idr_n <- function(a, b) {
      if (!has_idr) return(NA)
      tryCatch({ fit <- idr::est.IDR(cbind(abs(a), abs(b)), mu = 2.6, sigma = 1.3, rho = 0.8, p = 0.1,
                                     eps = 0.001, max.ite = 30)
                 sum(fit$IDR < 0.05) }, error = function(e) NA)
    }
    rp10 <- read.csv(f_pairs); cp6 <- list(); cl6 <- list()
    for (i in seq_len(nrow(configs7))) {
      cf <- configs7[i, ]; if (is.null(ds10[[cf$dataset]])) next
      rl <- real_labs(cf$dataset, cf$contrast); labs_f <- rl$labs
      lfc <- sapply(labs_f, function(l) rowMeans(l$A) - rowMeans(l$B))
      tops <- apply(lfc, 2, function(v) order(-abs(v))[1:K_LIST])
      pr <- combn(names(labs_f), 2)
      for (j in seq_len(ncol(pr))) {
        a <- pr[1, j]; b <- pr[2, j]
        r6 <- rp10[rp10$dataset == cf$dataset & rp10$contrast == cf$contrast & rp10$ranking == "LFC" &
                   rp10$lab1 == a & rp10$lab2 == b, ]
        cp6[[length(cp6) + 1]] <- data.frame(dataset = cf$dataset, contrast = cf$contrast, lab1 = a, lab2 = b,
          rbo_full_data = rbo_lists(tops[, a], tops[, b]),
          overlap_top100 = length(intersect(tops[, a], tops[, b])) / K_LIST,
          spearman_lfc = cor(lfc[, a], lfc[, b], method = "spearman"),
          idr_reproducible_n = idr_n(lfc[, a], lfc[, b]),
          E_two_reps = if (nrow(r6)) r6$E else NA, rho_hat = if (nrow(r6)) r6$rho_hat else NA)
      }
    }
    cmp <- do.call(rbind, cp6); write.csv(cmp, f10f, row.names = FALSE)
    for (i in seq_len(nrow(configs7))) {
      cf <- configs7[i, ]; d <- cmp[cmp$dataset == cf$dataset & cmp$contrast == cf$contrast, ]; if (!nrow(d)) next
      for (l in unique(c(d$lab1, d$lab2))) {
        s <- d[d$lab1 == l | d$lab2 == l, ]
        cl6[[length(cl6) + 1]] <- data.frame(dataset = cf$dataset, contrast = cf$contrast, lab = l,
          mean_rbo_full = mean(s$rbo_full_data), mean_overlap100 = mean(s$overlap_top100),
          mean_spearman = mean(s$spearman_lfc), mean_idr_n = mean(s$idr_reproducible_n),
          mean_E_two_reps = mean(s$E_two_reps), mean_rho_hat = mean(s$rho_hat))
      }
    }
    cl6 <- do.call(rbind, cl6)
    for (m in c("mean_rbo_full", "mean_overlap100", "mean_spearman", "mean_idr_n", "mean_E_two_reps", "mean_rho_hat"))
      cl6[[paste0("rank_", sub("mean_", "", m))]] <- ave(-cl6[[m]], cl6$dataset, cl6$contrast, FUN = function(z) rank(z, na.last = "keep"))
    write.csv(cl6, f10g, row.names = FALSE); print(cl6, digits = 3)
  }
  K_LIST <- K0; P_RBO <- P0
  cat(sprintf("step10 done. Time: %.1f min\n", as.numeric(difftime(Sys.time(), t10, units = "mins"))))
}
