save_fig <- function(name, w, h, plot_fun) {
  fp <- file.path(fig_dir, paste0(name, ".png")); fd <- file.path(fig_dir, paste0(name, ".pdf"))
  ok_png <- tryCatch({ png(fp, width = w, height = h, units = "in", res = FIG_DPI, type = "cairo")   # Yol A
                       plot_fun(); dev.off(); TRUE },
                     error = function(e) { try(dev.off(), silent = TRUE); FALSE })
  if (!ok_png) { png(fp, width = w, height = h, units = "in", res = FIG_DPI); plot_fun(); dev.off() }  # Yol B
  ok_pdf <- tryCatch({ cairo_pdf(fd, width = w, height = h); plot_fun(); dev.off(); TRUE },        # Yol A
                     error = function(e) { try(dev.off(), silent = TRUE); FALSE })
  if (!ok_pdf) { pdf(fd, width = w, height = h); plot_fun(); dev.off() }                         # Yol B
  cat("kaydedildi:", fp, "ve", fd, "\n")
}
