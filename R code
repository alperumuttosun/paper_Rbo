with_side_legend <- function(leg_text, plot_part, legend_part) {
  w_in <- max(sapply(leg_text, function(t) strwidth(t, units = "inches", cex = 0.85))) + 0.6  # en uzun yazı + simge payı (inç)
  layout(matrix(1:2, 1), widths = c(1, lcm(w_in * 2.54)))  # sol: grafik, sağ: yazıya göre genişlikte açıklama sütunu
  plot_part()                                               # grafik
  par(mar = c(0, 0, 0, 0)); plot.new()                      # boş alan
  legend_part()                                             # açıklama
}

