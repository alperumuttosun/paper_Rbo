# ---- step07: permutation tests ----
REDO_STEP07 <- FALSE  # TRUE recomputes the step
B_GLOBAL    <- 499  # permutations
SPL7        <- 30  # splits per laboratory
BTW7        <- 30  # lists per laboratory
R_S2B       <- 150  # repetitions of the batch simulation

f_glob <- "step07_global_tests.csv"
f_labt <- "step07_lab_tests.csv"
f_s2b  <- "step07_s2b_batch_sim.csv"
f_rcor <- "step07_replicate_cor.csv"

configs7 <- data.frame(dataset = c("MAQC", "MAQC", "SEQC"), contrast = c("A-B", "C-D", "A-B"),
                       ranking = c("LFC", "LFC", "LFC"))

lab_lists <- function(lab, ranking, s0) {
  C <- mean(replicate(SPL7, {
    ia <- sample(ncol(lab$A)); ib <- sample(ncol(lab$B))
    rbo_lists(list_sim(lab, ia[1:M_REP], ib[1:M_REP], ranking, s0),
              list_sim(lab, ia[M_REP + 1:M_REP], ib[M_REP + 1:M_REP], ranking, s0))
  }))
  pool <- replicate(BTW7, list_sim(lab, sample(ncol(lab$A), M_REP), sample(ncol(lab$B), M_REP), ranking, s0),
                    simplify = FALSE)
  list(C = C, pool = pool)
}

all_stats <- function(labs, ranking, s0) {
  ll <- lapply(labs, lab_lists, ranking = ranking, s0 = s0)
  L <- length(labs); Cv <- sapply(ll, `[[`, "C")
  R <- matrix(NA, L, L, dimnames = list(names(labs), names(labs)))
  for (i in 1:(L - 1)) for (j in (i + 1):L) {
    E <- mean(mapply(rbo_lists, ll[[i]]$pool, ll[[j]]$pool))
    R[i, j] <- R[j, i] <- E / sqrt(Cv[i] * Cv[j])
  }
  glob <- mean(R[upper.tri(R)])
  labst <- sapply(1:L, function(l) {
    Ro <- R[-l, -l, drop = FALSE]
    mean(R[l, -l]) - mean(Ro[upper.tri(Ro)])
  })
  list(glob = glob, lab = setNames(labst, names(labs)), C = Cv, R = R)
}

permute_labs <- function(labs) {
  nA <- sapply(labs, function(l) ncol(l$A)); nB <- sapply(labs, function(l) ncol(l$B))
  PA <- do.call(cbind, lapply(labs, `[[`, "A")); PB <- do.call(cbind, lapply(labs, `[[`, "B"))
  gA <- split(sample(ncol(PA)), rep(seq_along(labs), nA)); gB <- split(sample(ncol(PB)), rep(seq_along(labs), nB))
  setNames(lapply(seq_along(labs), function(i) list(A = PA[, gA[[i]], drop = FALSE], B = PB[, gB[[i]], drop = FALSE])),
           names(labs))
}

sim_lab_batch <- function(cp, n, beta) {
  lab <- sim_lab(cp, n)
  bt <- rep(1:2, c(ceiling(n / 2), floor(n / 2)))
  for (b in 1:2) {
    lab$A[, bt == b] <- lab$A[, bt == b] + beta * cp$sigma * rnorm(nrow(cp))
    lab$B[, bt == b] <- lab$B[, bt == b] + beta * cp$sigma * rnorm(nrow(cp))
  }
  lab
}

rep_cor <- function(X) {
  Rz <- X - rowMeans(X)
  Rz <- Rz[apply(Rz, 1, sd) > 0, , drop = FALSE]
  cor(Rz)
}

if (!REDO_STEP07 && all(file.exists(c(f_glob, f_labt, f_s2b, f_rcor)))) {
